@page "/manage/{SiteId:guid}/orders"
@using WebsiteBuilder.Core.Entities
@using WebsiteBuilder.Web.Auth
@using WebsiteBuilder.Web.Management
@using WebsiteBuilder.Web.Shop
@attribute [Authorize]
@* Prerender off so OnInitializedAsync runs exactly once: it marks orders read, and a
   prerender + circuit double-run would clear the "new" state before this render shows it.
   The same trap the leads inbox documents. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject SiteManagementService Management
@inject OrdersService OrdersService

<PageTitle>Your orders</PageTitle>

<div class="orders-page">
    @if (_notFound)
    {
        <div class="empty-shell"><h1>We couldn't find that website</h1></div>
    }
    else if (_orders is null)
    {
        <div class="empty-shell"><p>Loading…</p></div>
    }
    else
    {
        <header class="op-top">
            <a class="back" href="/manage/@SiteId/edit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                Back to editor
            </a>
            <a class="brand" href="/">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="7" x="3" y="3" rx="1"/><rect width="9" height="7" x="3" y="14" rx="1"/><rect width="5" height="7" x="16" y="14" rx="1"/></svg>
                </span>
                @Branding.Name
            </a>
        </header>

        <div class="op-body">
            <div class="op-head">
                <div>
                    <h1>Orders</h1>
                    <p>Orders placed on your website. Nothing is paid online &mdash; call or message
                        the customer to confirm and arrange payment.</p>
                </div>
                <div class="op-stats">
                    <div class="stat">
                        <span class="stat-value">@_orders.Count</span>
                        <span class="stat-label">Total</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@_newCount</span>
                        <span class="stat-label">New</span>
                    </div>
                </div>
            </div>

            @if (_orders.Count == 0)
            {
                <div class="op-card empty">
                    <span class="empty-ico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                    </span>
                    <h2>No orders yet</h2>
                    <p>When someone places an order from your shop, it shows up here with what they
                        want and how to reach them.</p>
                    <a class="view-live" href="/manage/@SiteId/products">Manage your products</a>
                </div>
            }
            else
            {
                <div class="op-card">
                    <div class="table">
                        @foreach (var order in _orders)
                        {
                            <div class="order @(order.IsRead ? "" : "unread")" @key="order.Id">
                                <div class="order-main">
                                    <div class="order-top">
                                        @* A dot, not the word "New". The status chip beside it already
                                           says "New" for an unactioned order, and the two together read
                                           as one badge stuttering. These are different facts — "you have
                                           not opened this" and "this is not dealt with yet" — so both
                                           stay, but only one of them uses words. *@
                                        @if (!order.IsRead)
                                        {
                                            <span class="order-unread" title="You haven't opened this one yet"></span>
                                        }
                                        <span class="order-ref">@order.Reference</span>
                                        <span class="order-status @order.Status.ToString().ToLowerInvariant()">@StatusLabel(order.Status)</span>
                                        <span class="order-time">@TimeAgo(order.CreatedUtc)</span>
                                    </div>

                                    <div class="order-who">@order.CustomerName</div>

                                    <ul class="order-items">
                                        @foreach (var item in order.Items)
                                        {
                                            <li>
                                                <span>@item.Quantity &times; @item.ProductName</span>
                                                <span class="item-price">
                                                    @if (item.LineTotalMinor is { } lineTotal)
                                                    {
                                                        @OrderMessage.FormatMoney(lineTotal, item.Currency)
                                                    }
                                                    else
                                                    {
                                                        <text>price on request</text>
                                                    }
                                                </span>
                                            </li>
                                        }
                                    </ul>

                                    @if (!string.IsNullOrWhiteSpace(order.Note))
                                    {
                                        <div class="order-note">@order.Note</div>
                                    }

                                    <div class="order-contacts">
                                        @if (!string.IsNullOrWhiteSpace(order.PhoneNumber))
                                        {
                                            <a href="tel:@order.PhoneNumber">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384z"/></svg>
                                                @order.PhoneNumber
                                            </a>
                                            @* wa.me wants the number without a plus or spaces. This is the
                                               button the owner will actually use — most of these conversations
                                               finish in WhatsApp. *@
                                            <a href="https://wa.me/@WhatsAppNumber(order.PhoneNumber)" target="_blank" rel="noopener">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                                                WhatsApp
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.Email))
                                        {
                                            <a href="mailto:@order.Email">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                                @order.Email
                                            </a>
                                        }
                                    </div>
                                </div>

                                <div class="order-side">
                                    <span class="order-total">
                                        @if (order.TotalMinor is { } total && order.Currency is { } currency)
                                        {
                                            @OrderMessage.FormatMoney(total, currency)
                                        }
                                        else
                                        {
                                            <span class="untotalled">Confirm total</span>
                                        }
                                    </span>

                                    @* The owner moves the order along by hand. Nothing else can know:
                                       there is no payment and no courier to hear it from. *@
                                    <div class="order-actions">
                                        @foreach (var next in NextStatuses(order.Status))
                                        {
                                            <button class="status-btn" disabled="@_busy"
                                                    @onclick="() => SetStatusAsync(order, next)">
                                                @ActionLabel(next)
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <p class="op-status">@_status</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SiteId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Order>? _orders;
    private bool _notFound;
    private bool _busy;
    private int _newCount;
    private string _status = "";

    protected override async Task OnInitializedAsync()
    {
        // Orders carry customers' names, phone numbers and addresses, so this gate matters as much
        // as the one on the leads inbox.
        var managed = await Management.LoadAsync(SiteId, await AuthState.OwnerIdAsync());
        if (managed is null)
        {
            _notFound = true;
            return;
        }

        _orders = await OrdersService.ListForSiteAsync(SiteId);
        _newCount = _orders.Count(o => !o.IsRead);

        // Opening the inbox counts as reading. The count above is captured first, so this render
        // still shows what was new; the next visit will read zero. Runs once (prerender is off).
        if (_newCount > 0)
        {
            await OrdersService.MarkAllReadAsync(SiteId);
        }
    }

    private async Task SetStatusAsync(Order order, OrderStatus status)
    {
        _busy = true;
        try
        {
            if (await OrdersService.SetStatusAsync(order.Id, status))
            {
                order.Status = status;
                _status = $"Order {order.Reference} marked {StatusLabel(status).ToLowerInvariant()}.";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Where an order can go from here. Fulfilled and cancelled are ends — reopening one is rare
    /// enough that offering it on every row would only make the common actions harder to hit.
    /// </summary>
    private static OrderStatus[] NextStatuses(OrderStatus status) => status switch
    {
        OrderStatus.New => [OrderStatus.Confirmed, OrderStatus.Cancelled],
        OrderStatus.Confirmed => [OrderStatus.Fulfilled, OrderStatus.Cancelled],
        _ => [],
    };

    private static string StatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.Confirmed => "Confirmed",
        OrderStatus.Fulfilled => "Done",
        OrderStatus.Cancelled => "Cancelled",
        _ => "New",
    };

    private static string ActionLabel(OrderStatus status) => status switch
    {
        OrderStatus.Confirmed => "Confirm",
        OrderStatus.Fulfilled => "Mark done",
        OrderStatus.Cancelled => "Cancel",
        _ => "Reopen",
    };

    /// <summary>Strips a phone number down to the digits wa.me accepts.</summary>
    private static string WhatsAppNumber(string phone) => new(phone.Where(char.IsDigit).ToArray());

    private static string TimeAgo(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        if (span < TimeSpan.FromMinutes(1)) return "just now";
        if (span < TimeSpan.FromHours(1)) return $"{(int)span.TotalMinutes} min ago";
        if (span < TimeSpan.FromDays(1)) return $"{(int)span.TotalHours} hour{(span.TotalHours < 2 ? "" : "s")} ago";
        if (span < TimeSpan.FromDays(2)) return "Yesterday";
        if (span < TimeSpan.FromDays(7)) return $"{(int)span.TotalDays} days ago";
        return when.ToString("d MMM");
    }
}
