@page "/manage/{SiteId:guid}/products"
@using WebsiteBuilder.Core.Entities
@using WebsiteBuilder.Web.Auth
@using WebsiteBuilder.Web.Images
@using WebsiteBuilder.Web.Management
@using WebsiteBuilder.Web.Shop
@attribute [Authorize]
@rendermode InteractiveServer
@inject IServiceProvider Services
@inject SiteManagementService Management
@inject ProductsService ProductsService

<PageTitle>Your products</PageTitle>

<div class="products-page">
    @if (_notFound)
    {
        <div class="empty-shell"><h1>We couldn't find that website</h1></div>
    }
    else if (_products is null)
    {
        <div class="empty-shell"><p>Loading…</p></div>
    }
    else
    {
        <header class="pp-top">
            <a class="back" href="/manage/@SiteId/edit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                Back to editor
            </a>
            <a class="brand" href="/">@Branding.Name</a>
        </header>

        <div class="pp-body">
            <div class="pp-head">
                <div>
                    <h1>Products</h1>
                    <p>What you sell. Changes go live straight away &mdash; there is no separate publish for products.</p>
                </div>
                <button class="primary" @onclick="AddAsync" disabled="@_busy">Add an item</button>
            </div>

            @* Two different things are live here and saying only the first misleads. Products save
               straight to the live catalog, but the shop *section* lives in the draft like every
               other section, so it takes a publish before a visitor sees any of this. *@
            @if (!_hasShopSection)
            {
                <p class="note">
                    Your website has no shop section yet, so none of these items appear on it.
                    Open the <a href="/manage/@SiteId/edit">editor</a>, add <strong>Shop</strong> from the
                    section picker, then <strong>publish</strong> — the section is part of your draft, so it
                    only goes live when you publish.
                </p>
            }

            @if (_products.Count == 0)
            {
                <div class="pp-card empty">
                    <p>Nothing here yet. Add your first item and it appears on your website.</p>
                </div>
            }
            else
            {
                @foreach (var product in _products)
                {
                    <div class="pp-card @(product.IsAvailable ? "" : "off")" @key="product.Id">
                        @* The photo cell only exists when an image store is configured, so the
                           column count has to follow it. Without this the grid still declared three
                           columns, auto-placement dropped the fields into the 140px photo column
                           and the delete button into the content column, and the whole row was
                           inside-out on every environment with no Cloudinary keys. *@
                        <div class="pp-row @(_images is null ? "no-photo" : "")">
                            @if (_images is not null)
                            {
                                <ImageField Store="_images" TenantId="product.TenantId" AddLabel="Add a photo"
                                            Url="@product.ImageUrl"
                                            UrlChanged="url => { product.ImageUrl = url; Touch(product); }" />
                            }
                            <div class="pp-fields">
                                @* Saved on blur, not on every keystroke: an empty name falls back
                                   to a placeholder name, and doing that mid-edit means clearing
                                   the field to retype it puts "New item" straight back. *@
                                <input class="field name" @bind="product.Name"
                                       @bind:after="() => Touch(product)" placeholder="What is it called?" />
                                <textarea class="field" rows="2" @bind="product.Description" @bind:event="oninput"
                                          @bind:after="() => Touch(product)" placeholder="A line or two about it"></textarea>
                                <div class="pp-price">
                                    <label>
                                        Price
                                        <input class="field" type="text" inputmode="decimal"
                                               value="@PriceText(product)"
                                               @onchange="e => SetPrice(product, e.Value?.ToString())"
                                               placeholder="@("Leave blank for \"ask us\"")" />
                                    </label>
                                    <label>
                                        Currency
                                        @* Also on blur: this is upper-cased and defaulted on save,
                                           which fights you if it happens between keystrokes. *@
                                        <input class="field short" @bind="product.Currency"
                                               @bind:after="() => Touch(product)" maxlength="3" />
                                    </label>
                                    <label class="pp-toggle">
                                        <input type="checkbox" checked="@product.IsAvailable"
                                               @onchange="e => SetAvailable(product, (bool)(e.Value ?? false))" />
                                        For sale
                                    </label>
                                </div>
                                <p class="pp-address">Address on your site: <code>/products/@product.Slug</code></p>
                            </div>
                            @* Two "Remove"s sat in this row — one detached the photo, one destroyed
                               the product for good, and the destructive one was the quieter of the
                               two. It is now named for what it deletes and asks first, because
                               there is no draft to undo it from: products are live data. *@
                            @if (_confirming == product.Id)
                            {
                                <div class="pp-confirm">
                                    <span>Delete for good?</span>
                                    <button class="danger" @onclick="() => DeleteAsync(product)" disabled="@_busy">Delete</button>
                                    <button class="quiet" @onclick="() => _confirming = null" disabled="@_busy">Keep</button>
                                </div>
                            }
                            else
                            {
                                <button class="drop" @onclick="() => _confirming = product.Id" disabled="@_busy">Delete item</button>
                            }
                        </div>
                    </div>
                }

                <p class="pp-status">@_status</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SiteId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Product>? _products;
    private IImageStore? _images;
    private bool _notFound;
    private bool _hasShopSection;
    private bool _busy;
    private string _status = "";
    private Guid? _confirming;

    protected override async Task OnInitializedAsync()
    {
        _images = Services.GetService<IImageStore>();

        var ownerId = await AuthState.OwnerIdAsync();
        var managed = await Management.LoadAsync(SiteId, ownerId);

        // Loading through the management service is what puts this site's tenant in scope; every
        // product query below relies on that, and on it having refused a site that is not theirs.
        if (managed is null)
        {
            _notFound = true;
            return;
        }

        _hasShopSection = managed.Site.Draft.Sections.Any(s => s is Core.SiteModel.ShopSection);
        _products = await ProductsService.ListAsync();
    }

    private async Task AddAsync()
    {
        _busy = true;
        try
        {
            var product = await ProductsService.AddAsync("New item");
            _products!.Add(product);
            _status = "Added.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Product product)
    {
        _busy = true;
        try
        {
            await ProductsService.DeleteAsync(product.Id);
            _products!.Remove(product);
            _status = $"Deleted “{ProductName(product)}”.";
        }
        finally
        {
            _confirming = null;
            _busy = false;
        }
    }

    private static string ProductName(Product product) =>
        string.IsNullOrWhiteSpace(product.Name) ? "this item" : product.Name;

    /// <summary>
    /// Saves on every edit rather than behind a button. A product is live data, so there is no
    /// draft for an unsaved change to sit in — and an owner who typed a price and walked away
    /// should not come back to the old one.
    /// </summary>
    private async void Touch(Product product)
    {
        await ProductsService.SaveAsync(product);
        _status = "Saved.";
        await InvokeAsync(StateHasChanged);
    }

    private void SetAvailable(Product product, bool available)
    {
        product.IsAvailable = available;
        Touch(product);
    }

    private static string PriceText(Product product) =>
        product.PriceMinor is null ? "" : (product.PriceMinor.Value / 100m).ToString("0.00");

    /// <summary>
    /// Blank means "ask us", which is a real way to sell here. Anything unparseable is left alone
    /// rather than silently becoming zero — a free product is not what a typo meant.
    /// </summary>
    private void SetPrice(Product product, string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            product.PriceMinor = null;
            Touch(product);
            return;
        }

        if (decimal.TryParse(text.Trim(), System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var amount) && amount >= 0)
        {
            product.PriceMinor = (long)Math.Round(amount * 100, MidpointRounding.AwayFromZero);
            Touch(product);
        }
        else
        {
            _status = "That price didn't look like a number, so it wasn't changed.";
        }
    }
}
