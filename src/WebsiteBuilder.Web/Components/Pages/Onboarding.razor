@page "/start"
@using WebsiteBuilder.Core.Generation
@using WebsiteBuilder.Core.Onboarding
@using WebsiteBuilder.Core.SiteModel
@using WebsiteBuilder.Web.Images
@using WebsiteBuilder.Web.Auth
@using WebsiteBuilder.Web.Management
@using WebsiteBuilder.Web.Onboarding
@* Prerender off so OnInitializedAsync runs exactly once. It redeems the stashed interview, and a
   stash is redeemable once — with prerendering on, the prerender pass built the site and the
   circuit pass then found nothing and told the owner their answers had expired, on the very run
   that had just succeeded. Leads.razor is off for the same reason. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IServiceProvider Services
@inject OnboardingService OnboardingService
@inject OnboardingDraftStore DraftStore
@inject SiteManagementService Management
@inject NavigationManager Navigation

<PageTitle>Let's build your website</PageTitle>

<div class="onb">
    <header class="onb-top">
        <a class="brand" href="/">
            <span class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="7" x="3" y="3" rx="1"/><rect width="9" height="7" x="3" y="14" rx="1"/><rect width="5" height="7" x="16" y="14" rx="1"/></svg>
            </span>
            <span class="brand-name">@Branding.Name</span>
        </a>
        <div class="onb-top-right">
            <span class="autosave">Progress saved automatically</span>
            <a class="ghost-btn" href="/">Save &amp; exit</a>
        </div>
    </header>

    @if (_result is not null)
    {
        <div class="onb-center">
            <div class="done-card">
                <span class="done-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <h1>Your website is ready to look at</h1>
                <p>We've put together a first draft from your answers. Nothing is public yet — this is a preview only.</p>
                <p class="address">@_result.Subdomain.<span>@PlatformSuffix</span></p>
                <div class="actions">
                    <a class="secondary" href="@PreviewUrl">Preview</a>
                    <a class="primary" href="@EditorUrl">Start editing</a>
                </div>
            </div>
        </div>
    }
    else if (_building)
    {
        <div class="onb-center">
            <div class="building-card">
                @if (_failed)
                {
                    <h1>That didn't work</h1>
                    <p>Something went wrong building your website. Your answers are safe — let's try again.</p>
                    <div class="actions">
                        <button type="button" class="secondary" @onclick="BackToQuestions">Back to my answers</button>
                        <button type="button" class="primary" @onclick="Build">Try again</button>
                    </div>
                }
                else
                {
                    <span class="build-spark">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                    </span>
                    <h1>Building your website</h1>
                    <p class="hint">This usually takes under a minute. You can watch it come together.</p>
                    <ol class="stages">
                        @foreach (var (stage, label) in StageRows())
                        {
                            <li class="@StageClass(stage)">
                                <span class="dot"></span>
                                <span>@label</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>
    }
    else
    {
        <div class="onb-body">
            <div class="interview">
                <div class="progress-block">
                    <div class="progress-top">
                        <span class="step-count">Question @_wizard.StepNumber of @_wizard.StepCount</span>
                        <span class="step-name">@StepName(_wizard.CurrentStep)</span>
                    </div>
                    <div class="track" role="progressbar" aria-valuenow="@_wizard.StepNumber" aria-valuemin="1" aria-valuemax="@_wizard.StepCount">
                        <span style="width:@(_wizard.StepNumber * 100 / _wizard.StepCount)%"></span>
                    </div>
                </div>

                <div class="asker">
                    <span class="asker-avatar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
                    </span>
                    <span>@Branding.Name is asking</span>
                </div>

                @switch (_wizard.CurrentStep)
                {
                    case OnboardingStep.BusinessName:
                        <h1>What's your business called?</h1>
                        <p class="hint">This goes at the top of your website.</p>
                        <input class="field" @bind="_wizard.Answers.BusinessName" @bind:event="oninput" autofocus
                               placeholder="Joe's Plumbing" />
                        break;

                    case OnboardingStep.Category:
                        <h1>What kind of business is it?</h1>
                        <p class="hint">In your own words &mdash; plumber, hair salon, bakery.</p>
                        <input class="field" @bind="_wizard.Answers.Category" @bind:event="oninput" placeholder="Plumber" />
                        <p class="chips-label">Or start from a common type:</p>
                        <div class="chips">
                            @foreach (var suggestion in CategorySuggestions)
                            {
                                <button type="button" class="chip @(_wizard.Answers.Category == suggestion ? "on" : "")"
                                        @onclick="() => _wizard.Answers.Category = suggestion">@suggestion</button>
                            }
                        </div>
                        break;

                    case OnboardingStep.Offerings:
                        <h1>What do you offer?</h1>
                        <p class="hint">One per line. Three or four is plenty.</p>
                        <textarea class="field" rows="5" @bind="_offeringsText" @bind:event="oninput"
                                  placeholder="@("Drain clearing\nLeak repair\nBathroom fitting")"></textarea>
                        break;

                    case OnboardingStep.Tone:
                        <h1>How should your website sound?</h1>
                        <p class="hint">You can change this later.</p>
                        <div class="choices">
                            @foreach (var tone in Enum.GetValues<BusinessTone>())
                            {
                                <button type="button" class="choice @(_wizard.Answers.Tone == tone ? "selected" : "")"
                                        @onclick="() => _wizard.Answers.Tone = tone">
                                    <strong>@ToneLabel(tone)</strong>
                                    <span>@ToneHint(tone)</span>
                                </button>
                            }
                        </div>
                        break;

                    case OnboardingStep.Photos:
                        <h1>Got photos of your work?</h1>
                        <p class="hint">You can add these later &mdash; your website will look good without them.</p>
                        @if (Images is null)
                        {
                            <p class="note">Photo uploads aren't switched on yet. Skip for now &mdash; we'll use pictures that suit your kind of business, and you can swap them for your own later.</p>
                        }
                        else
                        {
                            <div class="shots">
                                @foreach (var url in _wizard.Answers.PhotoUrls)
                                {
                                    <div class="shot">
                                        <img src="@ImageDelivery.Cropped(url, 360, 240)" alt="" />
                                        <button type="button" class="shot-drop" @onclick="() => RemovePhoto(url)">Remove</button>
                                    </div>
                                }
                            </div>
                            <label class="upload">
                                <InputFile OnChange="AddPhotosAsync" multiple accept="image/*" disabled="@_uploading" />
                                <span>@(_uploading ? "Uploading…" : "Choose photos")</span>
                            </label>
                            <p class="hint">Up to @MaxPhotos photos, @(Images.MaxBytes / (1024 * 1024)) MB each. The first one goes at the top of your site.</p>
                            @if (_photoProblem is not null)
                            {
                                <p class="problem" role="alert">@_photoProblem</p>
                            }
                        }
                        break;

                    case OnboardingStep.Contact:
                        <h1>How should customers reach you?</h1>
                        <p class="hint">Fill in whichever you use. At least one, please.</p>
                        <label class="labelled">Phone<input class="field" @bind="_wizard.Answers.PhoneNumber" @bind:event="oninput" placeholder="+233 20 000 0000" /></label>
                        <label class="labelled">WhatsApp<input class="field" @bind="_wizard.Answers.WhatsAppNumber" @bind:event="oninput" placeholder="+233 20 000 0000" /></label>
                        <label class="labelled">Email<input class="field" @bind="_wizard.Answers.Email" @bind:event="oninput" placeholder="you@example.com" /></label>

                        <p class="hint spaced">What should customers do first?</p>
                        <div class="choices">
                            @foreach (var action in Enum.GetValues<PrimaryAction>())
                            {
                                <button type="button" class="choice @(_wizard.Answers.PrimaryAction == action ? "selected" : "")"
                                        @onclick="() => _wizard.Answers.PrimaryAction = action">
                                    <strong>@ActionLabel(action)</strong>
                                </button>
                            }
                        </div>
                        break;

                    case OnboardingStep.ServiceArea:
                        <h1>Where do you work?</h1>
                        <p class="hint">The area you cover, and your address if customers visit you.</p>
                        <label class="labelled">Area you cover<input class="field" @bind="_wizard.Answers.ServiceArea" @bind:event="oninput" placeholder="Osu and East Legon" /></label>
                        <label class="labelled">Address (optional)<textarea class="field" rows="3" @bind="_addressText" @bind:event="oninput"
                                                           placeholder="@("12 High Street\nOsu, Accra")"></textarea></label>
                        break;
                }

                @if (_problem is not null)
                {
                    <p class="problem" role="alert">@_problem</p>
                }

                <div class="nav-row">
                    @if (!_wizard.IsFirstStep)
                    {
                        <button type="button" class="back" @onclick="Back">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                            Back
                        </button>
                    }
                    else
                    {
                        <span></span>
                    }
                    <button type="button" class="continue" @onclick="Next">
                        @NextLabel
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            @{
                // The preview is the real generator run against the answers so far, not a mock:
                // whatever it shows is what pressing "Build my website" would produce, give or take
                // the model's wording. Rebuilt each render — it is pure string work, no I/O.
                var profile = PreviewProfile;
                var preview = PreviewSiteFor(profile);
                var previewHero = preview.Sections.OfType<HeroSection>().FirstOrDefault();
            }
            <aside class="preview-panel">
                <div class="preview-head">
                    <span class="preview-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                        Building your site as we talk
                    </span>
                    <span class="live-pill"><i></i>Live preview</span>
                </div>
                <div class="browser">
                    <div class="browser-bar">
                        <span class="dots"><i></i><i></i><i></i></span>
                        <span class="addr">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            @SubdomainSuggester.Slugify(profile.BusinessName).@PlatformSuffix
                        </span>
                    </div>
                    <div class="mini-page" style="--accent:@preview.Theme.Palette.Primary">
                        <div class="mini-nav">
                            <span class="mini-brand">@preview.Meta.BusinessName</span>
                            <span class="mini-links">
                                @foreach (var link in PreviewNavLinks(preview))
                                {
                                    <span>@link</span>
                                }
                            </span>
                            <span class="mini-call">@ContactActions.DefaultLabel(profile.PrimaryAction)</span>
                        </div>
                        <div class="mini-hero">
                            @if (!string.IsNullOrWhiteSpace(preview.Meta.Tagline))
                            {
                                <span class="mini-eyebrow">@preview.Meta.Tagline</span>
                            }
                            <div class="mini-head">@previewHero?.Headline</div>
                            <div class="mini-sub">@previewHero?.Subheadline</div>
                            <div class="mini-cta">
                                <span class="mini-primary">@previewHero?.CallToActionLabel</span>
                                @if (!string.IsNullOrWhiteSpace(profile.WhatsAppNumber))
                                {
                                    <span class="mini-secondary">WhatsApp us</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(previewHero?.ImageUrl))
                        {
                            <img class="mini-shot" src="@previewHero.ImageUrl" alt="" />
                        }
                        <div class="mini-strip">
                            @foreach (var offering in profile.Offerings.Take(3))
                            {
                                <span class="mini-feat">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>@offering
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private readonly OnboardingWizard _wizard = new();
    private string _offeringsText = "";
    private string _addressText = "";
    private string? _problem;
    private string? _photoProblem;
    private bool _uploading;
    private bool _building;

    private const int MaxPhotos = 6;

    /// <summary>
    /// Null when no photo provider is configured, in which case the step says so rather than
    /// offering a button that cannot work — the same rule the editor follows. Resolved from the
    /// provider rather than injected, because [Inject] throws on a service that isn't registered.
    /// </summary>
    private IImageStore? Images { get; set; }

    /// <summary>
    /// Onboarding has no tenant yet: the tenant is created at the end, from these answers. Uploads
    /// therefore land in a folder keyed by this interview, and stay there — moving them afterwards
    /// would buy tidier folder names at the price of rewriting URLs already saved in a site.
    /// </summary>
    private readonly Guid _uploadScope = Guid.NewGuid();
    private bool _failed;
    private OnboardingProgress? _stage;
    private OnboardingResult? _result;

    [Inject] private Microsoft.Extensions.Options.IOptions<Core.Tenancy.TenantResolutionOptions> TenantOptions { get; set; } = default!;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Set when the visitor is coming back from sign-in with an interview waiting to be built.</summary>
    [SupplyParameterFromQuery(Name = "claim")]
    private string? ClaimKey { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Images = Services.GetService<IImageStore>();

        if (string.IsNullOrEmpty(ClaimKey))
        {
            return;
        }

        var stashed = DraftStore.Take(ClaimKey);

        if (stashed is null)
        {
            await NothingToClaimAsync();
            return;
        }

        _wizard.Restore(stashed);
        _offeringsText = string.Join("\n", stashed.Offerings);
        _addressText = string.Join("\n", stashed.AddressLines);

        await Build();
    }

    /// <summary>
    /// The claim key bought nothing: the stash expired, or this link has already been followed.
    /// <para>
    /// The second case is far more likely than the first, because a claim link is exactly the kind
    /// of URL people revisit — from their email a second time, or by refreshing. If the site it
    /// built already exists, telling its owner to answer seven questions again is both wrong and
    /// alarming. Only somebody with no site at all is genuinely starting over.
    /// </para>
    /// </summary>
    private async Task NothingToClaimAsync()
    {
        var ownerId = await AuthState.OwnerIdAsync();

        if (ownerId is not null)
        {
            var sites = await Management.ListForOwnerAsync(ownerId.Value);

            if (sites.Count > 0)
            {
                Navigation.NavigateTo("/dashboard");
                return;
            }
        }

        _problem = "That took a little too long, so we didn't keep your answers. It's only a few questions — let's go again.";
    }

    private string PlatformSuffix => TenantOptions.Value.PlatformDomain;

    private string PreviewUrl => $"/preview/{_result!.SiteId}";

    private string EditorUrl => $"/manage/{_result!.SiteId}/edit";

    private string NextLabel => _wizard.CurrentStep == OnboardingStep.ServiceArea
        ? "Build my website"
        : OnboardingWizard.IsOptional(_wizard.CurrentStep) && !HasAnswered(_wizard.CurrentStep)
            ? "Skip"
            : "Continue";

    /// <summary>
    /// Whether an optional step has been given something. "Skip" is the honest label for an empty
    /// optional question and a worrying one after you have just uploaded six photos — it reads as
    /// though the work is about to be thrown away.
    /// </summary>
    private bool HasAnswered(OnboardingStep step) => step switch
    {
        OnboardingStep.Photos => _wizard.Answers.PhotoUrls.Count > 0,
        OnboardingStep.ServiceArea => !string.IsNullOrWhiteSpace(_wizard.Answers.ServiceArea)
                                      || !string.IsNullOrWhiteSpace(_addressText),
        _ => false,
    };

    // Straight from the category catalog, so a template added there shows up here. Free text still
    // works — these exist so the common cases land on a curated page without the owner having to
    // guess our wording.
    private static IReadOnlyList<string> CategorySuggestions => CategoryTemplateCatalog.Examples;

    private static readonly TemplateSiteGenerator PreviewGenerator = new();

    /// <summary>
    /// The answers so far, with an example standing in for anything not yet given. The example is
    /// what makes the first screen look like a website rather than an empty box; each answer
    /// replaces its part of it, which is the whole promise of "building your site as we talk".
    /// </summary>
    private BusinessProfile PreviewProfile
    {
        get
        {
            var answers = _wizard.Answers;

            // Read the text areas directly. Their contents only reach Answers on Next/Back, and a
            // preview that ignored what is on screen right now would be the bug this replaced.
            var offerings = SplitLines(_offeringsText);
            var address = SplitLines(_addressText);

            return new BusinessProfile
            {
                BusinessName = Or(answers.BusinessName, "Rapid Flow Plumbing"),
                Category = Or(answers.Category, "plumber"),
                Offerings = offerings.Count > 0 ? offerings : ["Drain clearing", "Leak repair", "Bathroom fitting"],
                Tone = answers.Tone,
                PrimaryAction = answers.PrimaryAction,
                PhoneNumber = answers.PhoneNumber,
                WhatsAppNumber = answers.WhatsAppNumber,
                Email = answers.Email,
                ServiceArea = answers.ServiceArea,
                AddressLines = address,
            };
        }
    }

    private static SiteDefinition PreviewSiteFor(BusinessProfile profile) => PreviewGenerator.Generate(profile);

    /// <summary>
    /// The headings of the sections the site will actually have, which is how the owner sees that
    /// a restaurant gets a menu and a plumber gets services.
    /// </summary>
    private static IEnumerable<string> PreviewNavLinks(SiteDefinition site) => site.Sections
        .Select(section => section switch
        {
            ServicesSection services => services.Heading,
            // "About Joe's Plumbing" is the right heading on the page and far too long in a nav
            // bar, where every other item is two words.
            AboutSection about => about.Heading.Contains(site.Meta.BusinessName, StringComparison.OrdinalIgnoreCase)
                ? "About"
                : about.Heading,
            GallerySection gallery => gallery.Heading,
            ContactSection contact => contact.Heading,
            _ => null,
        })
        .OfType<string>()
        .Where(heading => !string.IsNullOrWhiteSpace(heading))
        .Take(3);

    private static string Or(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    /// <summary>
    /// Uploads a selection one photo at a time. A file that is too large or that the provider
    /// rejects is counted and skipped rather than failing the batch: losing four good photos of
    /// someone's shop over a fifth bad one is the wrong trade.
    /// </summary>
    private async Task AddPhotosAsync(InputFileChangeEventArgs e)
    {
        if (Images is null)
        {
            return;
        }

        _uploading = true;
        _photoProblem = null;

        var room = MaxPhotos - _wizard.Answers.PhotoUrls.Count;
        var rejected = 0;

        try
        {
            foreach (var file in e.GetMultipleFiles(MaxPhotos).Take(Math.Max(room, 0)))
            {
                try
                {
                    if (file.Size > Images.MaxBytes)
                    {
                        rejected++;
                        continue;
                    }

                    await using var stream = file.OpenReadStream(Images.MaxBytes);
                    var stored = await Images.UploadAsync(stream, file.Name, file.ContentType, _uploadScope);

                    _wizard.Answers.PhotoUrls.Add(stored.Url);

                    // Show each photo as it lands rather than after the whole batch.
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception)
                {
                    rejected++;
                }
            }
        }
        finally
        {
            _uploading = false;
        }

        var megabytes = Images.MaxBytes / (1024 * 1024);

        _photoProblem = rejected switch
        {
            0 => null,
            1 => $"One photo didn't upload. It may be larger than {megabytes} MB.",
            _ => $"{rejected} photos didn't upload. They may be larger than {megabytes} MB.",
        };
    }

    private void RemovePhoto(string url)
    {
        _wizard.Answers.PhotoUrls.Remove(url);
        _photoProblem = null;
    }

    private static string StepName(OnboardingStep step) => step switch
    {
        OnboardingStep.BusinessName => "Your business",
        OnboardingStep.Category => "About your business",
        OnboardingStep.Offerings => "What you offer",
        OnboardingStep.Tone => "Your style",
        OnboardingStep.Photos => "Photos",
        OnboardingStep.Contact => "Getting in touch",
        OnboardingStep.ServiceArea => "Where you work",
        _ => "",
    };

    private async Task Next()
    {
        CaptureTextAreas();

        _problem = _wizard.TryAdvance();
        if (_problem is not null || !_wizard.IsComplete)
        {
            return;
        }

        // The interview is deliberately anonymous — asking someone to make an account before they
        // have seen anything is how you lose them. Sign-in is required only here, at the point
        // where there is something real to save and a reason to want it.
        var ownerId = await AuthState.OwnerIdAsync();

        if (ownerId is null)
        {
            var key = DraftStore.Stash(_wizard.Answers);
            var claimUrl = $"/start?claim={key}";

            // forceLoad: sign-in writes a cookie, which needs a real request rather than a
            // client-side navigation inside this circuit.
            Navigation.NavigateTo(
                $"{AuthEndpoints.SignInPath}?returnUrl={Uri.EscapeDataString(claimUrl)}",
                forceLoad: true);
            return;
        }

        await Build();
    }

    private async Task Build()
    {
        var ownerId = await AuthState.OwnerIdAsync();

        if (ownerId is null)
        {
            // Only reachable if the session ended between finishing the interview and this call.
            _problem = "Your sign-in expired. Sign in again and we'll build your site.";
            return;
        }

        _building = true;
        _failed = false;
        _stage = null;

        var reporter = new Progress<OnboardingProgress>(stage =>
        {
            _stage = stage;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            _result = await OnboardingService.CompleteAsync(_wizard.Answers, ownerId.Value, reporter);
        }
        catch (Exception)
        {
            // Never show a stack trace to someone who just wanted a website.
            _failed = true;
        }
    }

    private void Back()
    {
        CaptureTextAreas();
        _problem = null;
        _wizard.GoBack();
    }

    private void BackToQuestions()
    {
        _building = false;
        _failed = false;
        _wizard.GoBack();
    }

    /// <summary>The stepper's fixed rows; the transient "revising" state relabels the writing row.</summary>
    private IEnumerable<(OnboardingProgress Stage, string Label)> StageRows()
    {
        yield return (OnboardingProgress.Preparing, "Setting up your website");
        yield return (OnboardingProgress.WritingCopy, _stage == OnboardingProgress.Revising ? "Polishing the wording" : "Writing your words");
        yield return (OnboardingProgress.BuildingPages, "Choosing your look and building your pages");
        yield return (OnboardingProgress.Finishing, "Almost ready");
    }

    private string StageClass(OnboardingProgress row)
    {
        var current = Order(_stage ?? OnboardingProgress.Preparing);
        var rowOrder = Order(row);
        if (rowOrder < current) return "done";
        if (rowOrder == current) return "active";
        return "pending";
    }

    private static int Order(OnboardingProgress stage) => stage switch
    {
        OnboardingProgress.Preparing => 0,
        OnboardingProgress.WritingCopy => 1,
        OnboardingProgress.Revising => 1,
        OnboardingProgress.BuildingPages => 2,
        _ => 3,
    };

    private void CaptureTextAreas()
    {
        if (_wizard.CurrentStep == OnboardingStep.Offerings)
        {
            _wizard.Answers.Offerings = SplitLines(_offeringsText);
        }

        if (_wizard.CurrentStep == OnboardingStep.ServiceArea)
        {
            _wizard.Answers.AddressLines = SplitLines(_addressText);
        }
    }

    private static List<string> SplitLines(string value) =>
        value.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private static string ToneLabel(BusinessTone tone) => tone switch
    {
        BusinessTone.Professional => "Calm and professional",
        BusinessTone.Bold => "Bold and direct",
        _ => "Warm and friendly",
    };

    private static string ToneHint(BusinessTone tone) => tone switch
    {
        BusinessTone.Professional => "Steady, reassuring, understated",
        BusinessTone.Bold => "Confident, short sentences, strong colours",
        _ => "Approachable, like talking to a neighbour",
    };

    private static string ActionLabel(PrimaryAction action) => action switch
    {
        PrimaryAction.Visit => "Visit us",
        PrimaryAction.Book => "Book an appointment",
        PrimaryAction.Message => "Message us",
        _ => "Call us",
    };
}
