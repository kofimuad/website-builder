@page "/manage/{SiteId:guid}/edit"
@using Microsoft.JSInterop
@using WebsiteBuilder.Core.Generation
@using WebsiteBuilder.Core.SiteModel
@using WebsiteBuilder.Core.Tenancy
@using WebsiteBuilder.Web.Auth
@using WebsiteBuilder.Web.Images
@using WebsiteBuilder.Web.Management
@using WebsiteBuilder.Web.Platform
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject SiteManagementService Management
@inject IServiceProvider Services
@inject IAssistantRateLimiter RateLimiter
@inject PlatformUrls Urls
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<TenantResolutionOptions> TenantOptions

<PageTitle>Edit your website</PageTitle>

@if (_notFound)
{
    <div class="shell"><div class="empty"><h1>We couldn't find that website</h1></div></div>
}
else if (_site is null)
{
    <div class="shell"><div class="empty"><p>Loading…</p></div></div>
}
else
{
    <div class="bar">
        <span class="status @(_dirty ? "busy" : "")">
            <svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            @_status
        </span>
        <div class="bar-actions">
            <button type="button" class="btn" @onclick="() => _showThemes = !_showThemes">Look</button>
            <button type="button" class="btn" @onclick="TryAnotherLook">Try another look</button>
            <button type="button" class="btn" @onclick="OpenPreview">Preview</button>
            <a class="btn" href="/manage/@SiteId/profile">Business details</a>
            <a class="btn" href="/manage/@SiteId/leads">Leads</a>
            <a class="btn" href="/manage/@SiteId/products">Products</a>
            <button type="button" class="btn primary" @onclick="Publish" disabled="@_publishing">Publish</button>
        </div>
    </div>

    @if (_showAddress)
    {
        <div class="sheet-backdrop" @onclick="CloseAddress">
            <div class="sheet" @onclick:stopPropagation="true">
                <h2>Choose your web address</h2>
                <p class="sheet-lead">
                    This is the link you'll give customers. Pick it now — once your site is live
                    the address stays put, so links you've shared keep working.
                </p>

                <div class="addr-row">
                    <input class="addr-input @(_addressProblem == SubdomainProblem.None ? "" : "bad")"
                           value="@_addressInput"
                           @oninput="OnAddressInput"
                           placeholder="your-business"
                           aria-label="Your web address"
                           autocomplete="off" />
                    <span class="addr-suffix">.@PlatformDomain</span>
                </div>

                <p class="addr-note @(_addressProblem == SubdomainProblem.None ? "ok" : "bad")">
                    @if (_addressChecking)
                    {
                        <span>Checking…</span>
                    }
                    else if (_addressProblem == SubdomainProblem.None)
                    {
                        <span>@PreviewAddress is free.</span>
                    }
                    else
                    {
                        <span>@SubdomainPolicy.Describe(_addressProblem)</span>
                    }
                </p>

                <div class="sheet-actions">
                    <button type="button" class="btn" @onclick="CloseAddress">Not yet</button>
                    <button type="button" class="btn primary"
                            disabled="@(_publishing || _addressChecking || _addressProblem != SubdomainProblem.None)"
                            @onclick="ConfirmAddressAndPublish">
                        @(_publishing ? "Publishing…" : "Publish my website")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_showLive)
    {
        <div class="sheet-backdrop" @onclick="() => _showLive = false">
            <div class="sheet live" @onclick:stopPropagation="true">
                <div class="live-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <h2>Your website is live</h2>
                <p class="sheet-lead">Anyone with this link can see it now.</p>

                <div class="live-url">
                    <input readonly value="@_liveUrl" aria-label="Your website address" />
                    <button type="button" class="btn" @onclick="CopyLink">@(_copied ? "Copied" : "Copy")</button>
                </div>

                <div class="live-actions">
                    <a class="btn primary" href="@WhatsAppShareUrl" target="_blank" rel="noopener">
                        Share on WhatsApp
                    </a>
                    <a class="btn" href="@_liveUrl" target="_blank" rel="noopener">Open my site</a>
                    <button type="button" class="btn" @onclick="() => _showLive = false">Done</button>
                </div>
            </div>
        </div>
    }

    @if (_showThemes)
    {
        <div class="themes">
            <div class="themes-head">
                <span>Choose a look — your words stay the same</span>
                <button type="button" @onclick="() => _showThemes = false">Close</button>
            </div>
            <div class="themes-grid">
                @foreach (var preset in ThemePresetCatalog.Presets)
                {
                    <button type="button" class="swatch @(IsCurrent(preset) ? "on" : "")" @onclick="() => ApplyTheme(preset)">
                        <span class="chips">
                            <i style="background:@preset.Theme.Palette.Primary"></i>
                            <i style="background:@preset.Theme.Palette.Accent"></i>
                            <i style="background:@preset.Theme.Palette.Surface"></i>
                        </span>
                        <span class="swatch-label">@preset.Label</span>
                    </button>
                }
            </div>
        </div>
    }

    @if (_showPreview)
    {
        <div class="preview-overlay">
            <div class="preview-bar">
                <div class="widths" role="group" aria-label="Preview width">
                    <button type="button" class="@(_phoneWidth ? "" : "on")" @onclick="() => _phoneWidth = false">Desktop</button>
                    <button type="button" class="@(_phoneWidth ? "on" : "")" @onclick="() => _phoneWidth = true">Phone</button>
                </div>
                <div class="preview-bar-actions">
                    <button type="button" class="btn" @onclick="RefreshPreview">Refresh</button>
                    <button type="button" class="btn" @onclick="() => _showPreview = false">Close</button>
                </div>
            </div>
            <div class="preview-stage">
                <div class="preview-frame @(_phoneWidth ? "phone" : "desktop")">
                    <iframe title="Preview" src="/preview/@SiteId?v=@_previewNonce"></iframe>
                </div>
            </div>
        </div>
    }

    <div class="canvas">
        <p class="tip">Click any text to edit it. Your changes save on their own.</p>

        @if (_undoLabel is not null)
        {
            <div class="undo" role="status">
                <span>@_undoLabel</span>
                <button type="button" @onclick="Undo">Undo</button>
            </div>
        }

        @for (var i = 0; i < _site.Draft.Sections.Count; i++)
        {
            var index = i;
            var section = _site.Draft.Sections[index];
            <section class="block">
                <div class="block-tools">
                    @if (_assistant is not null)
                    {
                        <button type="button" class="ai" title="Ask AI" @onclick="() => OpenAi(index)">✨</button>
                    }
                    <button type="button" title="Move up" disabled="@(index == 0)" @onclick="() => Move(index, -1)">↑</button>
                    <button type="button" title="Move down" disabled="@(index == _site.Draft.Sections.Count - 1)" @onclick="() => Move(index, 1)">↓</button>
                    <button type="button" class="danger" title="Remove" @onclick="() => Delete(index)">✕</button>
                </div>
                @switch (section)
                {
                    case HeroSection hero:
                        <input class="edit h1" @bind="hero.Headline" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Your headline" />
                        <textarea class="edit lead" rows="2" @bind="hero.Subheadline" @bind:event="oninput" @bind:after="MarkDirty" placeholder="A supporting line"></textarea>
                        <input class="edit button" @bind="hero.CallToActionLabel" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Button text" />
                        @if (_images is not null)
                        {
                            <ImageField Store="_images" TenantId="_site.TenantId" AddLabel="Add a main photo"
                                        Url="hero.ImageUrl"
                                        UrlChanged="url => { hero.ImageUrl = url; MarkDirty(); }" />
                        }
                        break;

                    case AboutSection about:
                        <input class="edit h2" @bind="about.Heading" @bind:event="oninput" @bind:after="MarkDirty" placeholder="About heading" />
                        <textarea class="edit body" rows="4" @bind="about.Body" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Tell customers about your business"></textarea>
                        @if (_images is not null)
                        {
                            <ImageField Store="_images" TenantId="_site.TenantId" AddLabel="Add a photo"
                                        Url="about.ImageUrl"
                                        UrlChanged="url => { about.ImageUrl = url; MarkDirty(); }" />
                        }
                        break;

                    case ServicesSection services:
                        <input class="edit h2" @bind="services.Heading" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Services heading" />
                        @foreach (var item in services.Items)
                        {
                            <div class="item">
                                <input class="edit h3" @bind="item.Title" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Service name" />
                                <textarea class="edit body" rows="2" @bind="item.Description" @bind:event="oninput" @bind:after="MarkDirty" placeholder="What it is"></textarea>
                                <input class="edit small" @bind="item.PriceLabel" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Price (optional)" />
                            </div>
                        }
                        break;

                    case TestimonialsSection testimonials:
                        <input class="edit h2" @bind="testimonials.Heading" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Reviews heading" />
                        @foreach (var quote in testimonials.Items)
                        {
                            <div class="item">
                                <textarea class="edit body" rows="2" @bind="quote.Quote" @bind:event="oninput" @bind:after="MarkDirty" placeholder="What they said"></textarea>
                                <input class="edit small" @bind="quote.AuthorName" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Who said it" />
                            </div>
                        }
                        break;

                    case GallerySection gallery:
                        <input class="edit h2" @bind="gallery.Heading" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Gallery heading" />
                        @if (_images is null)
                        {
                            <p class="muted">Photos can be added once picture uploads are switched on.</p>
                        }
                        else
                        {
                            @foreach (var image in gallery.Images.ToList())
                            {
                                var photo = image;
                                <div class="item gal">
                                    <img class="gal-thumb" src="@ImageDelivery.Cropped(photo.Url, 360, 240)" alt="" />
                                    <input class="edit small" @bind="photo.AltText" @bind:event="oninput" @bind:after="MarkDirty"
                                           placeholder="Describe this photo — helps Google and screen readers" />
                                    <button type="button" class="gal-drop" @onclick="() => RemoveGalleryImage(gallery, photo)">Remove</button>
                                </div>
                            }

                            <label class="gal-add @(_galleryBusy ? "busy" : "")">
                                <InputFile OnChange="e => AddGalleryImagesAsync(gallery, e)" multiple accept="image/*" disabled="@_galleryBusy" />
                                <span>@(_galleryBusy ? "Uploading…" : "Add photos")</span>
                            </label>

                            @if (_galleryError is not null)
                            {
                                <p class="gal-error" role="alert">@_galleryError</p>
                            }
                        }
                        break;

                    case ContactSection contact:
                        <input class="edit h2" @bind="contact.Heading" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Contact heading" />
                        <p class="muted">Phone, WhatsApp and email are edited on the Business details page so they stay correct everywhere.</p>
                        break;

                    case HoursMapSection hoursMap:
                        <input class="edit h2" @bind="hoursMap.Heading" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Find-us heading" />
                        <p class="muted">Address and opening hours are edited on the Business details page.</p>
                        break;

                    case CtaSection cta:
                        <input class="edit h2" @bind="cta.Headline" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Closing line" />
                        <input class="edit button" @bind="cta.ButtonLabel" @bind:event="oninput" @bind:after="MarkDirty" placeholder="Button text" />
                        break;
                }

                @if (_aiIndex == index)
                {
                    <div class="ai-panel">
                        <input class="ai-input" @bind="_aiText" @bind:event="oninput"
                               placeholder="Tell the assistant what to change — e.g. &quot;make this friendlier&quot;" disabled="@_aiBusy" />
                        <div class="ai-actions">
                            <button type="button" @onclick="() => CloseAi()" disabled="@_aiBusy">Cancel</button>
                            <button type="button" class="go" @onclick="() => RunAi(index)" disabled="@_aiBusy">
                                @(_aiBusy ? "Working…" : "Update")
                            </button>
                        </div>
                        @if (_aiError is not null)
                        {
                            <p class="ai-error" role="alert">@_aiError</p>
                        }
                    </div>
                }
            </section>
        }

        <div class="add">
            @if (_showPicker)
            {
                <div class="picker">
                    <div class="picker-head">
                        <span>Add a section</span>
                        <button type="button" @onclick="() => _showPicker = false">Close</button>
                    </div>
                    <div class="picker-grid">
                        @foreach (var entry in SectionCatalog.Entries)
                        {
                            <button type="button" class="picker-item" @onclick="() => AddSection(entry)">
                                <strong>@entry.Label</strong>
                                <span>@entry.Description</span>
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="add-btn" @onclick="() => _showPicker = true">+ Add a section</button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid SiteId { get; set; }

    private Core.Entities.Site? _site;
    private bool _notFound;
    private string _status = "Saved";
    private bool _dirty;
    private bool _publishing;
    private bool _showPreview;
    private bool _phoneWidth;
    private int _previewNonce;
    private bool _showPicker;
    private bool _showThemes = true;

    private string _subdomain = "";
    private bool _showAddress;
    private string _addressInput = "";
    private SubdomainProblem _addressProblem = SubdomainProblem.None;
    private bool _addressChecking;
    private CancellationTokenSource? _addressDebounce;

    private bool _showLive;
    private string _liveUrl = "";
    private bool _copied;
    private string? _undoLabel;
    private Action? _undoAction;
    private CancellationTokenSource? _debounce;

    private ISectionAssistant? _assistant;
    private int? _aiIndex;
    private string _aiText = "";
    private string? _aiError;
    private bool _aiBusy;

    /// <summary>Null when no image provider is configured; the editor then offers no uploads.</summary>
    private IImageStore? _images;

    private bool _galleryBusy;
    private string? _galleryError;

    /// <summary>Ceiling on one gallery selection, so a full camera roll can't be picked by accident.</summary>
    private const int MaxPhotosPerSelection = 12;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _assistant = Services.GetService<ISectionAssistant>();
        _images = Services.GetService<IImageStore>();

        // Someone else's site id resolves to null here, exactly like one that does not exist.
        var managed = await Management.LoadAsync(SiteId, await AuthState.OwnerIdAsync());
        if (managed is null)
        {
            _notFound = true;
            return;
        }

        _site = managed.Site;
        _subdomain = managed.Subdomain;
        _addressInput = managed.Subdomain;
    }

    private void OpenAi(int index)
    {
        _aiIndex = index;
        _aiText = "";
        _aiError = null;
    }

    private void CloseAi()
    {
        _aiIndex = null;
        _aiError = null;
    }

    private async Task RunAi(int index)
    {
        if (_assistant is null || string.IsNullOrWhiteSpace(_aiText))
        {
            return;
        }

        if (!RateLimiter.TryAcquire(_site!.TenantId))
        {
            _aiError = "You've reached today's AI edits. Try again tomorrow.";
            return;
        }

        _aiBusy = true;
        _aiError = null;
        try
        {
            var original = _site.Draft.Sections[index];
            var revised = await _assistant.ReviseAsync(original, _aiText);
            _site.Draft.Sections[index] = revised;

            _undoLabel = "The assistant updated this section.";
            _undoAction = () => _site.Draft.Sections[index] = original;
            _aiIndex = null;
            _aiText = "";
            MarkDirty();
        }
        catch (Exception)
        {
            _aiError = "The assistant couldn't make that change. Please try rewording it.";
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void RemoveGalleryImage(GallerySection gallery, GalleryImage photo)
    {
        var index = gallery.Images.IndexOf(photo);
        if (index < 0)
        {
            return;
        }

        gallery.Images.RemoveAt(index);
        _galleryError = null;

        _undoLabel = "Photo removed.";
        _undoAction = () => gallery.Images.Insert(Math.Min(index, gallery.Images.Count), photo);
        MarkDirty();
    }

    /// <summary>
    /// Uploads a whole selection. Each photo is independent: one that is too large or that the
    /// provider rejects is counted and skipped, because discarding four good photos over a fifth
    /// bad one is the wrong trade for someone adding pictures of their work.
    /// </summary>
    private async Task AddGalleryImagesAsync(GallerySection gallery, InputFileChangeEventArgs e)
    {
        if (_images is null)
        {
            return;
        }

        _galleryBusy = true;
        _galleryError = null;

        var rejected = 0;
        try
        {
            foreach (var file in e.GetMultipleFiles(MaxPhotosPerSelection))
            {
                try
                {
                    if (file.Size > _images.MaxBytes)
                    {
                        rejected++;
                        continue;
                    }

                    await using var stream = file.OpenReadStream(_images.MaxBytes);
                    var stored = await _images.UploadAsync(stream, file.Name, file.ContentType, _site!.TenantId);

                    gallery.Images.Add(new GalleryImage { Url = stored.Url, AltText = "" });
                    MarkDirty();

                    // Show each photo as it lands rather than after the whole batch.
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception)
                {
                    rejected++;
                }
            }
        }
        finally
        {
            _galleryBusy = false;
        }

        _galleryError = rejected switch
        {
            0 => null,
            1 => $"One photo didn't upload. It may be larger than {_images.MaxBytes / (1024 * 1024)} MB.",
            _ => $"{rejected} photos didn't upload. They may be larger than {_images.MaxBytes / (1024 * 1024)} MB.",
        };
    }

    private void Move(int index, int delta)
    {
        var sections = _site!.Draft.Sections;
        var target = index + delta;
        if (target < 0 || target >= sections.Count)
        {
            return;
        }

        (sections[index], sections[target]) = (sections[target], sections[index]);
        MarkDirty();
    }

    private void Delete(int index)
    {
        var sections = _site!.Draft.Sections;
        var section = sections[index];
        sections.RemoveAt(index);

        _undoLabel = "Section removed.";
        _undoAction = () => sections.Insert(Math.Min(index, sections.Count), section);
        MarkDirty();
    }

    private void Undo()
    {
        _undoAction?.Invoke();
        _undoAction = null;
        _undoLabel = null;
        MarkDirty();
    }

    private void AddSection(SectionCatalogEntry entry)
    {
        _site!.Draft.Sections.Add(entry.Create());
        _showPicker = false;
        _undoLabel = null;
        _undoAction = null;
        MarkDirty();
    }

    private bool IsCurrent(ThemePreset preset) =>
        _site is not null && string.Equals(_site.Draft.Theme.Palette.Primary, preset.Theme.Palette.Primary, StringComparison.OrdinalIgnoreCase);

    /// <summary>Applies a curated look. Only the theme changes — every word of copy is preserved.</summary>
    private void ApplyTheme(ThemePreset preset)
    {
        var previous = _site!.Draft.Theme;
        _site.Draft.Theme = preset.Theme.Clone();

        _undoLabel = $"Look changed to {preset.Label}.";
        _undoAction = () => _site.Draft.Theme = previous;
        _showThemes = false;
        MarkDirty();
    }

    private void TryAnotherLook()
    {
        var current = _site!.Draft.Theme.Palette.Primary;
        var others = ThemePresetCatalog.Presets
            .Where(p => !string.Equals(p.Theme.Palette.Primary, current, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (others.Count == 0)
        {
            return;
        }

        ApplyTheme(others[Random.Shared.Next(others.Count)]);
    }

    /// <summary>Every keystroke or structural change marks the draft dirty and (re)arms a short debounce.</summary>
    private void MarkDirty()
    {
        _dirty = true;
        _status = "Editing…";

        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        _ = SaveAfterPauseAsync(_debounce.Token);
    }

    private async Task SaveAfterPauseAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(1200, token);
        }
        catch (TaskCanceledException)
        {
            return; // A newer edit arrived; that one will save.
        }

        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (!_dirty)
        {
            return;
        }

        _status = "Saving…";
        await InvokeAsync(StateHasChanged);

        try
        {
            await Management.SaveDraftAsync();
            _dirty = false;
            _status = "Saved";
        }
        catch (Exception)
        {
            // Leave it dirty so the next edit (or the next debounce) retries.
            _status = "Couldn't save — will retry";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenPreview()
    {
        // Save first so the preview reflects the latest edits; the nonce busts the iframe cache.
        await SaveAsync();
        _previewNonce++;
        _showPreview = true;
    }

    private async Task RefreshPreview()
    {
        await SaveAsync();
        _previewNonce++;
    }

    private string PlatformDomain => TenantOptions.Value.PlatformDomain;

    private string PreviewAddress => $"{_addressInput}.{PlatformDomain}";

    /// <summary>
    /// wa.me with no number opens WhatsApp and lets the owner pick who to send to, which is what
    /// sharing means here — they are telling their own customers, not us messaging anyone.
    /// </summary>
    private string WhatsAppShareUrl =>
        $"https://wa.me/?text={Uri.EscapeDataString($"Take a look at my new website: {_liveUrl}")}";

    /// <summary>
    /// The first publish is the one that fixes the address, so it asks. Afterwards Publish means
    /// "push my changes" and should not interrupt.
    /// </summary>
    private async Task Publish()
    {
        if (_site is not null && !_site.IsPublished)
        {
            _addressInput = _subdomain;
            _addressProblem = SubdomainProblem.None;
            _showAddress = true;
            return;
        }

        await PublishNow(celebrate: false);
    }

    private void CloseAddress()
    {
        _showAddress = false;
        _addressDebounce?.Cancel();
        _addressChecking = false;
    }

    private async Task OnAddressInput(ChangeEventArgs args)
    {
        _addressInput = SubdomainPolicy.Normalize(args.Value?.ToString());

        // Their own address is not "free", but it is theirs. Without this, opening the dialog and
        // typing nothing would accuse the owner of clashing with themselves.
        if (string.Equals(_addressInput, _subdomain, StringComparison.Ordinal))
        {
            _addressDebounce?.Cancel();
            _addressChecking = false;
            _addressProblem = SubdomainProblem.None;
            return;
        }

        // Shape and reserved names are decided locally and instantly; only a name that could
        // actually be free is worth a round trip.
        var shape = SubdomainPolicy.Validate(_addressInput, TenantOptions.Value);
        if (shape != SubdomainProblem.None)
        {
            _addressDebounce?.Cancel();
            _addressChecking = false;
            _addressProblem = shape;
            return;
        }

        _addressDebounce?.Cancel();
        _addressDebounce?.Dispose();
        _addressDebounce = new CancellationTokenSource();
        var token = _addressDebounce.Token;

        _addressChecking = true;

        try
        {
            await Task.Delay(400, token);
            var problem = await Management.CheckSubdomainAsync(_addressInput, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            _addressProblem = problem;
            _addressChecking = false;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Superseded by a later keystroke; that call owns the state now.
        }
    }

    private async Task ConfirmAddressAndPublish()
    {
        if (!string.Equals(_addressInput, _subdomain, StringComparison.Ordinal))
        {
            _publishing = true;
            try
            {
                var problem = await Management.ChangeSubdomainAsync(SiteId, _addressInput);
                if (problem != SubdomainProblem.None)
                {
                    // Someone took it between the check and here. Stay on the dialog and say so.
                    _addressProblem = problem;
                    return;
                }

                _subdomain = _addressInput;
            }
            finally
            {
                _publishing = false;
            }
        }

        _showAddress = false;
        await PublishNow(celebrate: true);
    }

    private async Task PublishNow(bool celebrate)
    {
        _publishing = true;
        try
        {
            await SaveAsync();
            await Management.PublishAsync(SiteId);

            _liveUrl = Urls.TenantSite(_subdomain);
            _copied = false;
            _status = "Published — your changes are live";

            // Going live is worth a moment. Every republish after that is not.
            _showLive = celebrate;
        }
        catch (Exception)
        {
            _status = "Couldn't publish — please try again";
        }
        finally
        {
            _publishing = false;
        }
    }

    private async Task CopyLink()
    {
        try
        {
            // The only JavaScript this app calls. navigator.clipboard is invoked by path, so it
            // needs no script file of our own.
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _liveUrl);
            _copied = true;
        }
        catch (Exception)
        {
            // Blocked, or an insecure context. The link is in a focusable input either way.
            _copied = false;
        }
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _addressDebounce?.Cancel();
        _addressDebounce?.Dispose();
    }
}
