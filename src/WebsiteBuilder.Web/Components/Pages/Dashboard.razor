@page "/dashboard"
@using Microsoft.Extensions.Options
@using WebsiteBuilder.Core.Entities
@using WebsiteBuilder.Core.Onboarding
@using WebsiteBuilder.Core.Tenancy
@using WebsiteBuilder.Web.Auth
@using WebsiteBuilder.Web.Leads
@using WebsiteBuilder.Web.Management
@attribute [Authorize]
@inject SiteManagementService Management
@inject LeadsService LeadsService
@inject IOptions<TenantResolutionOptions> TenantOptions

<PageTitle>Your dashboard — Sitely</PageTitle>

@* Visitor statistics are deliberately absent: nothing counts them yet (WB-37), and a dashboard
   that invents numbers is worse than one that shows fewer. *@

<div class="dash">
    <aside class="sidebar">
        <a class="side-brand" href="/">
            <span class="side-mark">@Icon("layout-template")</span>
            <span class="side-word">Sitely</span>
        </a>

        <nav class="side-nav">
            @foreach (var item in NavItems())
            {
                <a class="nav-item @(item.Active ? "active" : "")" href="@item.Href">
                    <span class="nav-ico">@Icon(item.Icon)</span>
                    <span class="nav-label">@item.Label</span>
                    @if (item.Badge is not null)
                    {
                        <span class="nav-badge">@item.Badge</span>
                    }
                </a>
            }
        </nav>

        <div class="side-spacer"></div>

        <div class="upgrade">
            <div class="upgrade-t">You're on the free plan</div>
            <div class="upgrade-s">Connect your own domain and remove the Sitely badge.</div>
            <a class="upgrade-btn" href="#">Upgrade</a>
        </div>

        <div class="profile">
            <span class="profile-av">@Initial(_displayName)</span>
            <span class="profile-txt">
                <span class="profile-name">@_displayName</span>
                <span class="profile-biz">@(_primary?.Name ?? "No website yet")</span>
            </span>
        </div>

        <form method="post" action="/auth/signout" class="signout-form">
            <button type="submit" class="signout">Sign out</button>
        </form>
    </aside>

    <main class="main">
        @if (_loading)
        {
            <p class="loading">Loading…</p>
        }
        else if (_primary is null)
        {
            <header class="head">
                <div class="head-left">
                    <h1>@Greeting, @FirstName</h1>
                    <p>You haven't built a website yet. It takes about ten minutes.</p>
                </div>
                <div class="head-right">
                    <a class="btn solid" href="/start">@Icon("pencil") Build my website</a>
                </div>
            </header>
        }
        else
        {
            <header class="head">
                <div class="head-left">
                    <h1>@Greeting, @FirstName</h1>
                    <p>@SummaryLine</p>
                </div>
                <div class="head-right">
                    @if (_primary.IsPublished)
                    {
                        <a class="btn ghost" href="@LiveUrl(_primary)" target="_blank" rel="noopener">
                            @Icon("external-link") View site
                        </a>
                    }
                    else
                    {
                        <a class="btn ghost" href="/preview/@_primary.SiteId" target="_blank" rel="noopener">
                            @Icon("external-link") Preview
                        </a>
                    }
                    <a class="btn solid" href="/manage/@_primary.SiteId/edit">@Icon("pencil") Edit site</a>
                </div>
            </header>

            <section class="status-card">
                <div class="status-left">
                    <span class="status-dot @(_primary.IsPublished ? "" : "pending")">
                        @Icon(_primary.IsPublished ? "check" : "clock")
                    </span>
                    <div class="status-info">
                        <div class="status-row">
                            <span class="status-title">
                                @(_primary.IsPublished ? "Your site is live" : "Your site isn't published yet")
                            </span>
                            <span class="status-pill @(_primary.IsPublished ? "" : "draft")">
                                <i></i>@(_primary.IsPublished ? "Published" : "Draft")
                            </span>
                        </div>
                        <div class="status-url">
                            @Icon("globe")
                            <span>@HostFor(_primary)</span>
                            @if (_primary.PublishedUtc is not null)
                            {
                                <span class="status-updated">·&nbsp; Published @Ago(_primary.PublishedUtc.Value)</span>
                            }
                        </div>
                    </div>
                </div>
                @if (!_primary.IsPublished)
                {
                    <a class="domain-btn" href="/manage/@_primary.SiteId/edit">@Icon("pencil") Finish and publish</a>
                }
            </section>

            <section class="stats stats-3">
                <div class="stat">
                    <div class="stat-top">
                        <span class="stat-label">Leads</span>
                        <span class="stat-ico">@Icon("inbox")</span>
                    </div>
                    <div class="stat-value">@_primary.TotalLeads</div>
                    <div class="stat-note">All time</div>
                </div>
                <div class="stat">
                    <div class="stat-top">
                        <span class="stat-label">Waiting for a reply</span>
                        <span class="stat-ico">@Icon("bell")</span>
                    </div>
                    <div class="stat-value">@_primary.UnreadLeads</div>
                    <div class="stat-note @(_primary.UnreadLeads > 0 ? "up" : "")">
                        @(_primary.UnreadLeads > 0 ? "Reply today to win the job" : "Nothing outstanding")
                    </div>
                </div>
                <div class="stat">
                    <div class="stat-top">
                        <span class="stat-label">Website age</span>
                        <span class="stat-ico">@Icon("clock")</span>
                    </div>
                    <div class="stat-value">@DaysOld</div>
                    <div class="stat-note">Since you built it</div>
                </div>
            </section>

            <section class="bottom">
                <div class="leads-card">
                    <div class="leads-head">
                        <div class="leads-title">
                            <span>Recent leads</span>
                            @if (_primary.UnreadLeads > 0)
                            {
                                <span class="new-badge">@_primary.UnreadLeads new</span>
                            }
                        </div>
                        <a class="view-all" href="/manage/@_primary.SiteId/leads">View all</a>
                    </div>
                    <div class="table">
                        @if (_recentLeads.Count == 0)
                        {
                            <div class="lead-empty">
                                No enquiries yet. They'll appear here the moment someone fills in your
                                contact form.
                            </div>
                        }
                        else
                        {
                            @foreach (var lead in _recentLeads)
                            {
                                <a class="lead @(lead.IsRead ? "" : "unread")" href="/manage/@_primary.SiteId/leads">
                                    <span class="lead-av">@Initials(lead.Name)</span>
                                    <div class="lead-mid">
                                        <div class="lead-name-row">
                                            <span class="lead-name">@lead.Name</span>
                                            @if (!lead.IsRead)
                                            {
                                                <span class="lead-unread"></span>
                                            }
                                        </div>
                                        <div class="lead-msg">@lead.Message</div>
                                    </div>
                                    <div class="lead-meta">
                                        <span class="lead-via">@Icon(ChannelIcon(lead.Channel)) @ChannelLabel(lead.Channel)</span>
                                        <span class="lead-time">@Ago(lead.CreatedUtc)</span>
                                    </div>
                                </a>
                            }
                        }
                    </div>
                </div>

                <div class="side-col">
                    <div class="setup-card">
                        <div class="setup-head">
                            <span class="setup-title">Finish setting up</span>
                            <span class="setup-sub">
                                @DoneCount of @_setup.Count done@(DoneCount == _setup.Count ? " — all set." : " — you're almost there.")
                            </span>
                        </div>
                        <div class="setup-track"><span style="width:@(_setup.Count == 0 ? 0 : DoneCount * 100 / _setup.Count)%"></span></div>
                        <div class="tasks">
                            @foreach (var task in _setup)
                            {
                                <a class="task" href="@task.Href">
                                    <span class="task-cb @(task.Done ? "done" : "")">@(task.Done ? Icon("check") : default)</span>
                                    <span class="task-label @(task.Done ? "done" : "")">@task.Label</span>
                                    @if (!task.Done)
                                    {
                                        <span class="task-arrow">@Icon("chevron-right")</span>
                                    }
                                </a>
                            }
                        </div>
                    </div>

                    @if (_others.Count > 0)
                    {
                        <div class="setup-card">
                            <div class="setup-head">
                                <span class="setup-title">Your other websites</span>
                            </div>
                            <div class="tasks">
                                @foreach (var site in _others)
                                {
                                    <a class="task" href="/manage/@site.SiteId/edit">
                                        <span class="task-label">@site.Name</span>
                                        <span class="task-arrow">@Icon("chevron-right")</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <div class="tip-card">
                        <span class="tip-ico">@Icon("lightbulb")</span>
                        <div class="tip-title">Reply to leads within an hour</div>
                        <div class="tip-body">Businesses that respond quickly win up to 7× more jobs. We email you the moment a new lead comes in.</div>
                    </div>
                </div>
            </section>
        }
    </main>
</div>

@code {
    private record NavItem(string Icon, string Label, string Href, bool Active = false, string? Badge = null);
    private record SetupTask(string Label, bool Done, string Href);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private string _displayName = "";
    private OwnedSite? _primary;
    private List<OwnedSite> _others = [];
    private List<Lead> _recentLeads = [];
    private List<SetupTask> _setup = [];

    protected override async Task OnInitializedAsync()
    {
        var ownerId = await AuthState.OwnerIdAsync();

        if (ownerId is null)
        {
            // [Authorize] should have caught this; bail rather than render a half-built page.
            _loading = false;
            return;
        }

        _displayName = (await AuthState!).User.OwnerDisplayName();

        var sites = await Management.ListForOwnerAsync(ownerId.Value);
        _primary = sites.FirstOrDefault();
        _others = sites.Skip(1).ToList();

        if (_primary is not null)
        {
            // LoadAsync is the ownership gate and it also scopes the tenant, which the lead query
            // below relies on.
            var managed = await Management.LoadAsync(_primary.SiteId, ownerId);

            if (managed is not null)
            {
                _recentLeads = (await LeadsService.ListForSiteAsync(_primary.SiteId)).Take(5).ToList();
                _setup = BuildSetup(managed.Profile, _primary);
            }
        }

        _loading = false;
    }

    private List<SetupTask> BuildSetup(BusinessProfile profile, OwnedSite site) =>
    [
        new("Add how customers reach you",
            !string.IsNullOrWhiteSpace(profile.PhoneNumber)
            || !string.IsNullOrWhiteSpace(profile.WhatsAppNumber)
            || !string.IsNullOrWhiteSpace(profile.Email),
            $"/manage/{site.SiteId}/profile"),

        new("List what you offer",
            profile.Offerings.Any(o => !string.IsNullOrWhiteSpace(o)),
            $"/manage/{site.SiteId}/profile"),

        new("Add your address and opening hours",
            profile.AddressLines.Count > 0 || profile.OpeningHours.Count > 0,
            $"/manage/{site.SiteId}/profile"),

        new("Publish your website", site.IsPublished, $"/manage/{site.SiteId}/edit"),
    ];

    private int DoneCount => _setup.Count(t => t.Done);

    private IEnumerable<NavItem> NavItems()
    {
        yield return new NavItem("layout-dashboard", "Overview", "/dashboard", Active: true);

        if (_primary is null)
        {
            yield return new NavItem("globe", "Build a site", "/start");
            yield break;
        }

        yield return new NavItem("globe", "My site", $"/manage/{_primary.SiteId}/edit");
        yield return new NavItem("inbox", "Leads", $"/manage/{_primary.SiteId}/leads",
            Badge: _primary.UnreadLeads > 0 ? _primary.UnreadLeads.ToString() : null);
        yield return new NavItem("settings", "Business details", $"/manage/{_primary.SiteId}/profile");
    }

    private string SummaryLine
    {
        get
        {
            if (_primary is null) return "Let's get you online.";

            if (_primary.UnreadLeads > 0)
            {
                var noun = _primary.UnreadLeads == 1 ? "enquiry" : "enquiries";
                return $"You have {_primary.UnreadLeads} {noun} waiting for a reply.";
            }

            return _primary.IsPublished
                ? "Everything's running. Here's how your website is doing."
                : "Your site is ready to publish whenever you are.";
        }
    }

    private string HostFor(OwnedSite site) => $"{site.Subdomain}.{TenantOptions.Value.PlatformDomain}";

    private string LiveUrl(OwnedSite site) => $"//{HostFor(site)}/";

    // NOTE: the members below avoid switch expressions whose patterns start with "<". Inside a
    // .razor @code block the parser reads a leading "<" as the start of markup, so `< 30 => …`
    // silently becomes an unclosed tag. Plain comparisons keep the same logic parseable.

    private string DaysOld
    {
        get
        {
            var days = (int)(DateTimeOffset.UtcNow - _primary!.CreatedUtc).TotalDays;

            if (days < 1) return "Today";
            if (days == 1) return "1 day";
            if (days < 30) return $"{days} days";
            if (days < 365) return $"{days / 30} mo";
            return $"{days / 365} yr";
        }
    }

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;

            if (hour < 12) return "Good morning";
            if (hour < 18) return "Good afternoon";
            return "Good evening";
        }
    }

    // Written as an escape because a bare at-sign in a code block reads as a Razor transition.
    private const char AtSign = '@';

    private string FirstName
    {
        get
        {
            var first = _displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
            // Falls back to the email local part, which is what the claim holds before a name is known.
            var at = first.IndexOf(AtSign);
            return at > 0 ? first[..at] : first;
        }
    }

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : char.ToUpperInvariant(name[0]).ToString();

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => char.ToUpperInvariant(parts[0][0]).ToString(),
            _ => $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}",
        };
    }

    private static string ChannelIcon(LeadChannel channel) => channel switch
    {
        LeadChannel.WhatsApp => "message-circle",
        _ => "phone",
    };

    private static string ChannelLabel(LeadChannel channel) => channel switch
    {
        LeadChannel.WhatsApp => "WhatsApp",
        LeadChannel.Call => "Call tapped",
        LeadChannel.Other => "Other",
        _ => "Contact form",
    };

    private static string Ago(DateTimeOffset when)
    {
        var elapsed = DateTimeOffset.UtcNow - when;

        if (elapsed.TotalMinutes < 2) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes} min ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours} hr ago";
        if (elapsed.TotalDays < 2) return "yesterday";
        if (elapsed.TotalDays < 30) return $"{(int)elapsed.TotalDays} days ago";
        return when.ToString("d MMM yyyy");
    }

    private static readonly Dictionary<string, string> Icons = new()
    {
        ["layout-template"] = "<rect width='18' height='7' x='3' y='3' rx='1'/><rect width='9' height='7' x='3' y='14' rx='1'/><rect width='5' height='7' x='16' y='14' rx='1'/>",
        ["layout-dashboard"] = "<rect width='7' height='9' x='3' y='3' rx='1'/><rect width='7' height='5' x='14' y='3' rx='1'/><rect width='7' height='9' x='14' y='12' rx='1'/><rect width='7' height='5' x='3' y='16' rx='1'/>",
        ["globe"] = "<circle cx='12' cy='12' r='10'/><path d='M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20'/><path d='M2 12h20'/>",
        ["inbox"] = "<polyline points='22 12 16 12 14 15 10 15 8 12 2 12'/><path d='M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z'/>",
        ["settings"] = "<path d='M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z'/><circle cx='12' cy='12' r='3'/>",
        ["external-link"] = "<path d='M15 3h6v6'/><path d='M10 14 21 3'/><path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'/>",
        ["pencil"] = "<path d='M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z'/><path d='m15 5 4 4'/>",
        ["check"] = "<path d='M20 6 9 17l-5-5'/>",
        ["link"] = "<path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'/><path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'/>",
        ["phone"] = "<path d='M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384z'/>",
        ["message-circle"] = "<path d='M7.9 20A9 9 0 1 0 4 16.1L2 22z'/>",
        ["clock"] = "<circle cx='12' cy='12' r='10'/><path d='M12 6v6l4 2'/>",
        ["chevron-right"] = "<path d='m9 18 6-6-6-6'/>",
        ["lightbulb"] = "<path d='M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5'/><path d='M9 18h6'/><path d='M10 22h4'/>",
        ["bell"] = "<path d='M10.268 21a2 2 0 0 0 3.464 0'/><path d='M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326'/>",
    };

    private static MarkupString Icon(string name) => new(
        $"<svg class='icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>{Icons[name]}</svg>");
}
