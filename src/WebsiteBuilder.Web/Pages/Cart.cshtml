@page "/cart"
@using WebsiteBuilder.Core.SiteModel
@using WebsiteBuilder.Web.Shop
@model WebsiteBuilder.Web.Pages.CartModel
@{
    Layout = null;
    var chrome = Model.Chrome;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your order &mdash; @chrome.BusinessName</title>
    <meta name="robots" content="noindex" />
@await Html.PartialAsync("_SiteStyles", chrome)
</head>
<body class="@(chrome.HasCallBar ? "has-callbar" : "")">
@await Html.PartialAsync("_SiteTopBar", chrome)

<section>
    <div class="wrap">
        <p class="crumbs"><a href="/shop">&larr; Keep shopping</a></p>
        <h2>Your order</h2>

        @if (Model.Lines.Count == 0)
        {
            <p class="muted-note">Your order is empty.</p>
            <p><a class="button" href="/shop">Go to the shop</a></p>
        }
        else
        {
            <ul class="lines">
                @foreach (var line in Model.Lines)
                {
                    @* The photo column only exists when there is a photo. It used to be held open by
                       an empty span, so an item with no picture lost 4rem of a 360px screen to
                       nothing and its name wrapped mid-phrase. Same fix, and same reason, as the
                       products page in the builder. *@
                    <li class="line @(string.IsNullOrWhiteSpace(line.Product.ImageUrl) ? "line-no-photo" : "")">
                        @if (!string.IsNullOrWhiteSpace(line.Product.ImageUrl))
                        {
                            <img src="@ImageDelivery.Cropped(line.Product.ImageUrl, 160, 160)"
                                 alt="" width="160" height="160" loading="lazy" decoding="async" />
                        }
                        <span>
                            <span class="line-name">@line.Product.Name</span>
                            <span class="line-meta">
                                @if (line.TotalMinor is { } lineTotal)
                                {
                                    @($"{line.Quantity} × {line.Product.DisplayPrice()} = {OrderMessage.FormatMoney(lineTotal, line.Product.Currency)}")
                                }
                                else
                                {
                                    @($"{line.Quantity} × price on request")
                                }
                            </span>
                        </span>
                        <form method="post">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <input type="hidden" name="quantity" value="0" />
                            <button type="submit">Remove</button>
                        </form>
                    </li>
                }
            </ul>

            <div class="totals">
                <span>Total</span>
                @if (Model.TotalMinor is { } total && Model.Currency is { } currency)
                {
                    <strong>@OrderMessage.FormatMoney(total, currency)</strong>
                }
                else
                {
                    @* Mixed currencies, or nothing priced. The owner confirms rather than us guessing. *@
                    <strong class="line-meta">We'll confirm the total</strong>
                }
            </div>

            @* Checkout first, WhatsApp second. It used to be WhatsApp only, which meant the order
               existed only if the customer actually pressed send in the app they were handed off
               to — and if they did not, neither they nor the owner had anything. Placing the
               order records it and emails the owner; the message is then a nudge on top. *@
            <p><a class="button" href="/checkout">Place your order</a></p>
            <p class="line-meta">Nothing is paid here. @chrome.BusinessName will confirm your order
                and arrange payment with you.</p>

            @if (Model.OrderLink is { } orderLink)
            {
                <p class="alt-order">Or <a href="@orderLink">send it straight to @chrome.BusinessName on WhatsApp</a>
                    without leaving your details.</p>
            }
            else if (!string.IsNullOrWhiteSpace(chrome.Contact?.PhoneNumber))
            {
                <p class="alt-order">Or call <a href="tel:@chrome.Contact.PhoneNumber">@chrome.Contact.PhoneNumber</a> to order.</p>
            }
        }
    </div>
</section>

@await Html.PartialAsync("_SiteFooter", chrome)
</body>
</html>
