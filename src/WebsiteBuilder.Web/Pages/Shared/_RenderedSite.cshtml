@using WebsiteBuilder.Core.SiteModel
@model SiteDefinition
@{
    var site = Model;
    var theme = site.Theme;
    var title = string.IsNullOrWhiteSpace(site.Meta.SeoTitle) ? site.Meta.BusinessName : site.Meta.SeoTitle;
    var description = site.Meta.SeoDescription ?? site.Meta.Tagline;
    var visible = site.Sections.Where(s => s.Visible).ToList();

    // One anchor per section, so the nav can link to it and a repeated section type cannot produce
    // two elements with the same id.
    var anchors = new Dictionary<SiteSection, string>();
    var seen = new Dictionary<string, int>(StringComparer.Ordinal);
    foreach (var section in visible)
    {
        var kind = section switch
        {
            AboutSection => "about",
            ServicesSection => "services",
            GallerySection => "gallery",
            TestimonialsSection => "reviews",
            ContactSection => "contact",
            HoursMapSection => "find-us",
            CtaSection => "cta",
            _ => "top",
        };

        seen[kind] = seen.TryGetValue(kind, out var count) ? count + 1 : 1;
        anchors[section] = seen[kind] == 1 ? kind : $"{kind}-{seen[kind]}";
    }

    // The nav names sections by their own heading, so a restaurant's bar says "Our menu".
    var navLinks = visible
        .Select(s => (Anchor: anchors[s], Label: s switch
        {
            ServicesSection services => services.Heading,
            GallerySection gallery => gallery.Heading,
            AboutSection about => about.Heading.Contains(site.Meta.BusinessName, StringComparison.OrdinalIgnoreCase)
                ? "About"
                : about.Heading,
            HoursMapSection hours => hours.Heading,
            ContactSection contact => contact.Heading,
            _ => null,
        }))
        .Where(l => !string.IsNullOrWhiteSpace(l.Label))
        .Take(4)
        .ToList();

    var hero = visible.OfType<HeroSection>().FirstOrDefault();
    var contactDetails = visible.OfType<ContactSection>().FirstOrDefault();
    var headingStack = WebFontCatalog.StackFor(theme.Fonts.Heading);
    var bodyStack = WebFontCatalog.StackFor(theme.Fonts.Body);

    var hasCallBar = contactDetails is not null
        && (!string.IsNullOrWhiteSpace(contactDetails.PhoneNumber)
            || !string.IsNullOrWhiteSpace(contactDetails.WhatsAppNumber));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description" />
    }
    @* Styles are inlined: a published site is one document with no blocking requests. Fonts are
       served from our own origin for the same reason — see WebFontCatalog. *@
    <style>
        @foreach (var font in WebFontCatalog.Used(theme))
        {
            @:@@font-face {
            @:  font-family: "@font.Family";
            @:  src: url("/fonts/@font.FileName") format("woff2-variations");
            @:  font-weight: 400 700;
            @*  swap: the words appear immediately in the fallback and restyle when the file lands.
                On a slow connection, readable now beats correct later. *@
            @:  font-display: swap;
            @:}
        }
        :root {
            --primary: @theme.Palette.Primary;
            --accent: @theme.Palette.Accent;
            --background: @theme.Palette.Background;
            --surface: @theme.Palette.Surface;
            --text: @theme.Palette.Text;
            --muted: @theme.Palette.MutedText;
            @* Raw, because CSS reads an escaped quote as four literal characters and discards the
               declaration. WebFontCatalog.StackFor strips the name to safe characters first. *@
            --font-heading: @Html.Raw(headingStack);
            --font-body: @Html.Raw(bodyStack);
            --edge: color-mix(in srgb, var(--muted) 18%, transparent);
            --shadow: 0 1px 2px rgb(0 0 0 / .04), 0 8px 24px -12px rgb(0 0 0 / .18);
            --radius: 1rem;
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
        body {
            margin: 0;
            font-family: var(--font-body);
            color: var(--text);
            background: var(--background);
            line-height: 1.65;
            -webkit-text-size-adjust: 100%;
        }
        /* Room for the fixed call bar so the footer is never trapped underneath it. */
        body.has-callbar { padding-bottom: 4.75rem; }
        h1, h2, h3 { font-family: var(--font-heading); line-height: 1.12; margin: 0 0 .5em; letter-spacing: -.015em; }
        h2 { font-size: clamp(1.6rem, 4.5vw, 2.35rem); }
        h3 { font-size: 1.15rem; }
        p { margin: 0 0 1rem; }
        img { max-width: 100%; height: auto; display: block; }
        a { color: var(--primary); }
        section { padding: 3.5rem 1.25rem; }
        section:nth-of-type(even) { background: var(--surface); }
        .wrap { max-width: 64rem; margin: 0 auto; }

        /* ---------- top bar ---------- */
        .topbar {
            position: sticky; top: 0; z-index: 20;
            display: flex; align-items: center; gap: 1rem;
            padding: .7rem 1.25rem;
            background: color-mix(in srgb, var(--background) 88%, transparent);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--edge);
        }
        .topbar-brand {
            font-family: var(--font-heading); font-weight: 700; font-size: 1.05rem;
            color: var(--text); text-decoration: none; margin-right: auto;
        }
        .topbar-links { display: none; gap: 1.5rem; }
        .topbar-links a { color: var(--muted); text-decoration: none; font-size: .95rem; font-weight: 500; }
        .topbar-links a:hover { color: var(--text); }
        .topbar .button { margin: 0; padding: .55rem 1.1rem; font-size: .9rem; }

        /* ---------- hero ---------- */
        .hero { position: relative; padding: 0; background: var(--surface); }
        .hero-photo { position: relative; }
        .hero-photo img { width: 100%; height: clamp(15rem, 42vh, 26rem); object-fit: cover; }
        /* A scrim rather than a flat tint: the headline has to stay legible over a photo we have
           never seen, taken on a phone we do not control. */
        .hero-photo::after {
            content: ""; position: absolute; inset: 0;
            background: linear-gradient(180deg, rgb(0 0 0 / .15) 0%, rgb(0 0 0 / .62) 100%);
        }
        .hero-body { padding: 2.5rem 1.25rem 3rem; }
        .hero-photo + .hero-body {
            position: absolute; inset: auto 0 0 0; padding: 1.5rem 1.25rem 1.75rem; color: #fff;
        }
        .hero-photo + .hero-body h1, .hero-photo + .hero-body .hero-sub { color: #fff; }
        .hero-photo + .hero-body .eyebrow { background: rgb(255 255 255 / .18); color: #fff; }
        .hero h1 { font-size: clamp(2rem, 7.5vw, 3.4rem); margin-bottom: .35em; }
        .hero-sub { color: var(--muted); font-size: 1.075rem; max-width: 34rem; }
        .eyebrow {
            display: inline-block; margin-bottom: .9rem;
            padding: .3rem .8rem; border-radius: 9999px;
            background: color-mix(in srgb, var(--primary) 12%, transparent);
            color: var(--primary);
            font-size: .8rem; font-weight: 600; letter-spacing: .01em;
        }
        .hero-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.4rem; }

        /* ---------- buttons ---------- */
        .button {
            display: inline-block; padding: .8rem 1.5rem; border-radius: 9999px;
            background: var(--primary); color: #fff; text-decoration: none;
            font-weight: 600; font-size: 1rem; line-height: 1.2;
            box-shadow: var(--shadow); transition: transform .15s ease, filter .15s ease;
        }
        .button:hover { transform: translateY(-1px); filter: brightness(1.06); }
        .button-ghost {
            background: transparent; color: inherit;
            border: 1.5px solid currentColor; box-shadow: none;
        }

        /* ---------- cards ---------- */
        .grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
        .card {
            background: var(--background); border: 1px solid var(--edge);
            border-radius: var(--radius); padding: 1.4rem;
            box-shadow: var(--shadow);
        }
        .card h3 { margin-bottom: .35em; }
        .card p { margin: 0; color: var(--muted); }
        /* A short accent rule instead of an icon: nothing to invent, nothing to license. */
        .card::before {
            content: ""; display: block; width: 2rem; height: 3px; border-radius: 2px;
            background: var(--accent); margin-bottom: .9rem;
        }
        .price { color: var(--text); font-weight: 600; margin-top: .6rem !important; }

        .about-layout { display: grid; gap: 1.75rem; align-items: start; }
        .about-layout img { border-radius: var(--radius); box-shadow: var(--shadow); }

        .shots { display: grid; gap: .75rem; grid-template-columns: repeat(2, 1fr); }
        .shots figure { margin: 0; }
        .shots img { border-radius: .75rem; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }

        blockquote {
            margin: 0; padding: 1.5rem; background: var(--background);
            border: 1px solid var(--edge); border-radius: var(--radius); box-shadow: var(--shadow);
        }
        blockquote p { font-size: 1.05rem; }
        blockquote p::before { content: "“"; font-family: var(--font-heading); color: var(--accent); font-size: 1.6em; line-height: 0; vertical-align: -.25em; margin-right: .1em; }
        blockquote cite { display: block; margin-top: .75rem; color: var(--muted); font-style: normal; font-weight: 600; }

        /* ---------- contact ---------- */
        .contact-layout { display: grid; gap: 2rem; align-items: start; }
        .contact-links { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: .6rem; }
        .contact-links a {
            display: flex; align-items: center; gap: .6rem;
            padding: .85rem 1.1rem; border-radius: .75rem;
            background: var(--background); border: 1px solid var(--edge);
            color: var(--text); text-decoration: none; font-weight: 600;
        }
        .contact-links a:hover { border-color: var(--primary); }
        .enquiry { display: grid; gap: .75rem; }
        .enquiry input, .enquiry textarea {
            width: 100%; padding: .85rem 1rem;
            border: 1px solid var(--edge); border-radius: .75rem;
            font: inherit; color: var(--text); background: var(--background);
        }
        .enquiry textarea { resize: vertical; }
        .enquiry input:focus, .enquiry textarea:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
        .enquiry .button { border: 0; cursor: pointer; justify-self: start; }
        .enquiry .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
        .enquiry-error { color: #b42318; font-weight: 600; }
        .enquiry-sent {
            padding: 1.1rem 1.25rem; border-radius: var(--radius);
            background: color-mix(in srgb, var(--primary) 12%, var(--background));
            color: var(--text); font-weight: 600;
        }

        address { font-style: normal; font-size: 1.05rem; margin-bottom: 1rem; }
        table { border-collapse: collapse; width: 100%; max-width: 26rem; }
        td { padding: .4rem 0; border-bottom: 1px solid var(--edge); }
        td + td { text-align: right; color: var(--muted); }
        iframe { width: 100%; border: 0; aspect-ratio: 16 / 9; margin-top: 1.5rem; border-radius: var(--radius); }

        /* ---------- closing prompt ---------- */
        .closing { background: var(--primary); color: #fff; text-align: center; }
        .closing h2 { color: #fff; }
        .closing .button { background: #fff; color: var(--primary); }

        /* ---------- footer ---------- */
        .site-footer {
            padding: 2.5rem 1.25rem; background: var(--text); color: #fff;
            text-align: center; font-size: .9rem;
        }
        .site-footer strong { font-family: var(--font-heading); font-size: 1.1rem; display: block; margin-bottom: .4rem; }
        .site-footer a { color: #fff; }
        .site-footer p { color: rgb(255 255 255 / .72); margin: .35rem 0 0; }

        /* ---------- the call bar ----------
           Fixed to the bottom on phones. This audience calls and messages; making that one thumb
           press from anywhere on the page is worth more than anything else on it. */
        .callbar {
            position: fixed; inset: auto 0 0 0; z-index: 30;
            display: flex; gap: .5rem; padding: .6rem .75rem;
            padding-bottom: calc(.6rem + env(safe-area-inset-bottom));
            background: color-mix(in srgb, var(--background) 94%, transparent);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--edge);
        }
        .callbar a {
            flex: 1; text-align: center; padding: .8rem .5rem; border-radius: .75rem;
            text-decoration: none; font-weight: 700; font-size: .95rem;
        }
        .callbar .call { background: var(--primary); color: #fff; }
        .callbar .whatsapp { background: #25D366; color: #0b3d20; }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .button { transition: none; }
        }

        /* Mobile first: widen only once there is room. */
        @@media (min-width: 45rem) {
            section { padding: 5rem 2rem; }
            .topbar { padding: .8rem 2rem; }
            .topbar-links { display: flex; }
            .grid { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
            .shots { grid-template-columns: repeat(3, 1fr); }
            .about-layout, .contact-layout { grid-template-columns: 1fr 1fr; gap: 3rem; }
            .hero-photo img { height: clamp(20rem, 58vh, 34rem); }
            .hero-photo + .hero-body { padding: 2.5rem 2rem 3rem; }
            .hero-body { padding: 4rem 2rem 4.5rem; }
            /* The call bar is a phone affordance; a desktop visitor has the top bar. */
            .callbar { display: none; }
            body.has-callbar { padding-bottom: 0; }
        }
    </style>
</head>
<body class="@(hasCallBar ? "has-callbar" : "")">
<nav class="topbar">
    <a class="topbar-brand" href="#top">@site.Meta.BusinessName</a>
    <span class="topbar-links">
        @foreach (var link in navLinks)
        {
            <a href="#@link.Anchor">@link.Label</a>
        }
    </span>
    @if (hero is not null && !string.IsNullOrWhiteSpace(hero.CallToActionLabel) && !string.IsNullOrWhiteSpace(hero.CallToActionUrl))
    {
        <a class="button" href="@hero.CallToActionUrl">@hero.CallToActionLabel</a>
    }
</nav>
@foreach (var section in visible)
{
    switch (section)
    {
        case HeroSection heroSection:
            <header class="hero" id="top">
                @if (!string.IsNullOrWhiteSpace(heroSection.ImageUrl))
                {
                    <div class="hero-photo">
                        @* The one image above the fold, so it is fetched early and never lazily —
                           it is almost always the largest contentful paint. *@
                        <img src="@ImageDelivery.Cropped(heroSection.ImageUrl, 1600, 900)"
                             alt="" width="1600" height="900" decoding="async" fetchpriority="high" />
                    </div>
                }
                <div class="hero-body">
                    <div class="wrap">
                        @if (!string.IsNullOrWhiteSpace(site.Meta.Tagline))
                        {
                            <span class="eyebrow">@site.Meta.Tagline</span>
                        }
                        <h1>@heroSection.Headline</h1>
                        @if (!string.IsNullOrWhiteSpace(heroSection.Subheadline))
                        {
                            <p class="hero-sub">@heroSection.Subheadline</p>
                        }
                        <div class="hero-actions">
                            @if (!string.IsNullOrWhiteSpace(heroSection.CallToActionLabel) && !string.IsNullOrWhiteSpace(heroSection.CallToActionUrl))
                            {
                                <a class="button" href="@heroSection.CallToActionUrl">@heroSection.CallToActionLabel</a>
                            }
                            @if (contactDetails is not null && !string.IsNullOrWhiteSpace(contactDetails.WhatsAppNumber))
                            {
                                <a class="button button-ghost" href="https://wa.me/@contactDetails.WhatsAppNumber.TrimStart('+')">WhatsApp us</a>
                            }
                        </div>
                    </div>
                </div>
            </header>
            break;

        case AboutSection about:
            <section id="@anchors[section]">
                <div class="wrap about-layout">
                    <div>
                        <h2>@about.Heading</h2>
                        @foreach (var paragraph in about.Body.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <p>@paragraph</p>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(about.ImageUrl))
                    {
                        <img src="@ImageDelivery.Sized(about.ImageUrl, 1200)"
                             alt="" loading="lazy" decoding="async" />
                    }
                </div>
            </section>
            break;

        case ServicesSection services:
            <section id="@anchors[section]">
                <div class="wrap">
                    <h2>@services.Heading</h2>
                    <div class="grid">
                        @foreach (var item in services.Items)
                        {
                            <div class="card">
                                <h3>@item.Title</h3>
                                <p>@item.Description</p>
                                @if (!string.IsNullOrWhiteSpace(item.PriceLabel))
                                {
                                    <p class="price">@item.PriceLabel</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
            break;

        case GallerySection gallery:
            <section id="@anchors[section]">
                <div class="wrap">
                    <h2>@gallery.Heading</h2>
                    <div class="shots">
                        @foreach (var image in gallery.Images)
                        {
                            <figure style="margin:0">
                                @* Uniform crop: a grid of photos taken on different phones in
                                   different orientations otherwise renders as a ragged mess. *@
                                <img src="@ImageDelivery.Cropped(image.Url, 800, 600)"
                                     alt="@image.AltText" width="800" height="600" loading="lazy" decoding="async" />
                                @if (!string.IsNullOrWhiteSpace(image.Caption))
                                {
                                    <figcaption class="price">@image.Caption</figcaption>
                                }
                            </figure>
                        }
                    </div>
                </div>
            </section>
            break;

        case TestimonialsSection testimonials:
            <section id="@anchors[section]">
                <div class="wrap">
                    <h2>@testimonials.Heading</h2>
                    <div class="grid">
                        @foreach (var testimonial in testimonials.Items)
                        {
                            <blockquote>
                                <p>@testimonial.Quote</p>
                                <cite>@testimonial.AuthorName@(string.IsNullOrWhiteSpace(testimonial.AuthorDetail) ? "" : $", {testimonial.AuthorDetail}")</cite>
                            </blockquote>
                        }
                    </div>
                </div>
            </section>
            break;

        case ContactSection contact:
            <section id="@anchors[section]">
                <div class="wrap contact-layout">
                    <div>
                    <h2>@contact.Heading</h2>
                    <ul class="contact-links">
                        @if (!string.IsNullOrWhiteSpace(contact.PhoneNumber))
                        {
                            <li><a href="tel:@contact.PhoneNumber">Call @contact.PhoneNumber</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(contact.WhatsAppNumber))
                        {
                            <li><a href="https://wa.me/@contact.WhatsAppNumber.TrimStart('+')">Message on WhatsApp</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(contact.Email))
                        {
                            <li><a href="mailto:@contact.Email">@contact.Email</a></li>
                        }
                    </ul>
                    </div>

                    @if (contact.ShowEnquiryForm)
                    {
                        <div>
                        if (ViewData["EnquirySent"] is true)
                        {
                            <p class="enquiry-sent">Thanks — your message has been sent. We'll be in touch soon.</p>
                        }
                        else
                        {
                            <form class="enquiry" method="post" action="/">
                                @if (ViewData["EnquiryError"] is string enquiryError)
                                {
                                    <p class="enquiry-error">@enquiryError</p>
                                }
                                <input type="text" name="name" placeholder="Your name"
                                       value="@(ViewData["EnquiryName"])" required />
                                <input type="tel" name="phoneNumber" placeholder="Phone (so we can call you back)"
                                       value="@(ViewData["EnquiryPhone"])" />
                                <input type="email" name="email" placeholder="Email (optional)"
                                       value="@(ViewData["EnquiryEmail"])" />
                                <textarea name="message" rows="4" placeholder="How can we help?" required>@(ViewData["EnquiryMessage"])</textarea>
                                @* Honeypot: a real person never fills a hidden field. *@
                                <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
                                <button class="button" type="submit">Send message</button>
                            </form>
                        }
                        </div>
                    }
                </div>
            </section>
            break;

        case HoursMapSection hoursMap:
            <section id="@anchors[section]">
                <div class="wrap">
                    <h2>@hoursMap.Heading</h2>
                    @if (hoursMap.AddressLines.Count > 0)
                    {
                        <address>
                            @foreach (var line in hoursMap.AddressLines)
                            {
                                @line<br />
                            }
                        </address>
                    }
                    @if (hoursMap.OpeningHours.Count > 0)
                    {
                        <table>
                            <tbody>
                            @foreach (var hours in hoursMap.OpeningHours)
                            {
                                <tr>
                                    <td>@hours.Day</td>
                                    <td>
                                        @if (hours.Closed || hours.Opens is null || hours.Closes is null)
                                        {
                                            @:Closed
                                        }
                                        else
                                        {
                                            @($"{hours.Opens:HH\\:mm} – {hours.Closes:HH\\:mm}")
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    @if (!string.IsNullOrWhiteSpace(hoursMap.MapQuery))
                    {
                        <iframe title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                                src="https://maps.google.com/maps?q=@Uri.EscapeDataString(hoursMap.MapQuery)&output=embed"></iframe>
                    }
                </div>
            </section>
            break;

        case CtaSection cta:
            <section class="closing" id="@anchors[section]">
                <div class="wrap">
                    <h2>@cta.Headline</h2>
                    <a class="button" href="@cta.ButtonUrl">@cta.ButtonLabel</a>
                </div>
            </section>
            break;
    }
}

<footer class="site-footer">
    <strong>@site.Meta.BusinessName</strong>
    @if (contactDetails is not null && !string.IsNullOrWhiteSpace(contactDetails.PhoneNumber))
    {
        <p><a href="tel:@contactDetails.PhoneNumber">@contactDetails.PhoneNumber</a></p>
    }
    <p>&copy; @DateTime.UtcNow.Year @site.Meta.BusinessName</p>
</footer>

@if (contactDetails is not null
     && (!string.IsNullOrWhiteSpace(contactDetails.PhoneNumber) || !string.IsNullOrWhiteSpace(contactDetails.WhatsAppNumber)))
{
    @* Phone-only, and deliberately the last thing in the document: it is the one action most
       visitors to these sites are here to take, and it should never be more than a thumb away. *@
    <div class="callbar">
        @if (!string.IsNullOrWhiteSpace(contactDetails.PhoneNumber))
        {
            <a class="call" href="tel:@contactDetails.PhoneNumber">Call now</a>
        }
        @if (!string.IsNullOrWhiteSpace(contactDetails.WhatsAppNumber))
        {
            <a class="whatsapp" href="https://wa.me/@contactDetails.WhatsAppNumber.TrimStart('+')">WhatsApp</a>
        }
    </div>
}
</body>
</html>
