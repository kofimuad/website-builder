{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--viewport",
        "1440x900",
        "--screenshotFormat",
        "webp",
        "--screenshotMaxWidth",
        "1440",
        "--acceptInsecureCerts",
        "--no-usage-statistics"
      ]
    }
  }
}
